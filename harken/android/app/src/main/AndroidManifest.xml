<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The sync socket, and the media a track names. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The player: a foreground service while it plays, a wake lock so the
         stream does not stop with the screen, and its notification, which
         the onboarding asks for on Android 13 and later. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- enableOnBackInvokedCallback: the back gesture is predictive (Android 14
         and later), so a page shrinks back into its card under the finger and
         the full player comes down with it (Motion.kt, PlayerSheet.kt). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Harken.Starting"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Where the server's sign-in sends the code back to
                 (kotlin/ark-android, ArkApp.kt): harken://auth?code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="harken" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- The player and the media library (Playback.kt, Car.kt): what the
             notification, the lock screen, a headset and Android Auto reach.
             A car finds it by the two library actions, the platform's and
             Media3's; the session's own stays for a controller that asks for
             a session rather than a library. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- The covers, for a car, by content:// URI (CoverProvider.kt). Not
             exported: each URI is granted to the car it is handed to. -->
        <provider
            android:name=".CoverProvider"
            android:authorities="dev.harken.android.art"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Android Auto: harken is a media app (res/xml/automotive_app_desc.xml).
             Its icon there is the launcher's, the trumpet. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
