   workflow_dispatch:
 
 permissions:
@@ -34,6 +43,8 @@ concurrency:
 
 jobs:
   build:
+    # A failed APK run has nothing new to offer.
+    if: github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success'
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
@@ -60,6 +71,53 @@ jobs:
       - name: Build the browser peer
         run: nix build .#harken-web --print-build-logs
 
+      # The phone's F-Droid repository (harken/android/fdroid/README.md).
+      #
+      # The APK is not built here. apk.yml builds it with a store of its
+      # own, cached at 6 GB against this one's 2 GB in the 10 GB the two
+      # share, and building it again here would put gradle, the SDK and
+      # aapt2 in this cache as well — or rebuild them on every push. So this
+      # takes the newest APK apk.yml uploaded from main, which is why this
+      # workflow also runs when apk.yml finishes.
+      #
+      # Pages deploys the site whole, so the versions the live repository
+      # already offers are fetched back and kept, the newest three by
+      # version code, and the index is signed again over all of them: with
+      # the committed key, or with FDROID_KEYSTORE when that secret is set
+      # (nix/fdroid.nix says why). The fdroid tooling is not made a gc root:
+      # it is under a gigabyte from cache.nixos.org and two small Python
+      # builds, against a cache the wasm toolchain already fills.
+      #
+      # Nothing here fails the deploy. No APK anywhere, the live repository
+      # unreachable, or fdroid itself failing, and the site goes up without
+      # fdroid/, saying so.
+      - name: Lay out the F-Droid repository
+        env:
+          GH_TOKEN: ${{ github.token }}
+          FDROID_KEYSTORE: ${{ secrets.FDROID_KEYSTORE }}
+          FDROID_KEYSTORE_PASS: ${{ secrets.FDROID_KEYSTORE_PASS }}
+          FDROID_KEY_ALIAS: ${{ secrets.FDROID_KEY_ALIAS }}
+        run: |
+          apks=()
+          run=$(gh run list --repo "$GITHUB_REPOSITORY" --workflow apk.yml --branch main \
+            --status success --limit 1 --json databaseId --jq '.[0].databaseId // empty' || true)
+          if [ -n "$run" ] && gh run download "$run" --repo "$GITHUB_REPOSITORY" \
+            --name harken-debug-apk --dir "$RUNNER_TEMP/apk"; then
+            apks=("$RUNNER_TEMP/apk/harken-debug.apk")
+          else
+            echo "::notice::No APK from apk.yml; the F-Droid repository offers what it already had."
+          fi
+          if [ -z "$FDROID_KEYSTORE" ]; then
+            echo "Signing the F-Droid index with the committed key; FDROID_KEYSTORE is not set."
+          fi
+          if nix run .#harken-fdroid -- repo --keep https://k2on.github.io/apps/fdroid/repo \
+            "$RUNNER_TEMP/fdroid" "${apks[@]}"; then
+            mkdir -p _site/fdroid
+            cp -r "$RUNNER_TEMP/fdroid" _site/fdroid/repo
+          else
+            echo "::warning::No F-Droid repository in this deploy; the site goes up without fdroid/."
+          fi
+
       - name: Assemble the site
         run: |
           mkdir -p _site/harken
@@ -83,6 +141,9 @@ jobs:
           </body>
           </html>
           HTML
+          if [ -d _site/fdroid/repo ]; then
+            sed -i 's|^</body>|<p><a href="fdroid/repo/">fdroid/repo</a> is the Android app as an F-Droid repository: add that address in F-Droid and each APK built from main arrives as an update.</p>\n</body>|' _site/index.html
+          fi
 
       - uses: actions/configure-pages@v5
 
