 #
 # The nix store is kept between runs by nix-community/cache-nix-action, which
@@ -18,6 +20,13 @@ name: pages
 on:
   push:
     branches: [main]
+  # Again when an APK is built, so that the F-Droid repository offers it:
+  # a push deploys with the APK before it, and apk.yml's own run, a few
