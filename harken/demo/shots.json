{
  "_": "harken's screenshots (.github/screens/apps.md; which phones it is on is flake.nix's list, `publish`): its server is server.sh (the demo's catalogue as a media root its scanner reads), signed in to as `user`, who goes by `name`. `walk`: the phones' and the larger screens' (the same list), walked inside the app from a new install (ui/docs/shots.md, \"In the App\"): `welcome`, the first run's page; then signed in through the first run, landing on Home; and every shot after reached by tapping from where the last left it, each step naming an element by its id (`tab:library`, `library.show:albums`, `library.open-album:<title>`; a shot's `<id>.tree.txt` lists them). `player` plays the album open from its page's Play, grows the now-playing bar into the full player (`shell.open-player`, the accessory's own press) and pauses it there, so the picture holds still; `settings` puts it back and opens Settings from who is signed in. `desktop` is the window's (arkui's `host`, photographed by ui/rust/shots), the same walk signed in straight back from the run's dev server, but for `player`: the desktop's media player device is not wired yet, so nothing plays there. `screens` and `launch` are the Mac's and the browser's: each screen opened by its launch arguments (the Mac's own window over the demo library, app-mac.sh; the browser's address, app-web.sh, over the demo in the page).",
  "server": {
    "port": 8787,
    "user": "alex",
    "name": "Alex",
    "picture": "nix/demo/alex.jpg"
  },
  "walk": {
    "phone": [
      {
        "id": "welcome",
        "steps": []
      },
      {
        "id": "home",
        "signIn": true,
        "steps": [
          {
            "tap": "welcome.next"
          },
          {
            "tap": "welcome.typed"
          },
          {
            "type": "{server}"
          },
          {
            "tap": "welcome.check"
          },
          {
            "await": "tab:home"
          }
        ]
      },
      {
        "id": "search",
        "steps": [
          {
            "tap": "tab:search"
          }
        ]
      },
      {
        "id": "library",
        "steps": [
          {
            "tap": "tab:library"
          }
        ]
      },
      {
        "id": "albums",
        "steps": [
          {
            "tap": "library.show:albums"
          }
        ]
      },
      {
        "id": "album",
        "steps": [
          {
            "tap": "library.open-album:goldberg-variations-bwv-988"
          }
        ]
      },
      {
        "id": "player",
        "steps": [
          {
            "tap": "page.play-all:play"
          },
          {
            "await": "shell.open-player"
          },
          {
            "tap": "shell.open-player"
          },
          {
            "await": "player.toggle"
          },
          {
            "tap": "player.toggle"
          }
        ]
      },
      {
        "id": "settings",
        "steps": [
          {
            "tap": "shell.close-player"
          },
          {
            "tap": "shell.account"
          }
        ]
      }
    ],
    "large": [
      {
        "id": "welcome",
        "steps": []
      },
      {
        "id": "home",
        "signIn": true,
        "steps": [
          {
            "tap": "welcome.next"
          },
          {
            "tap": "welcome.typed"
          },
          {
            "type": "{server}"
          },
          {
            "tap": "welcome.check"
          },
          {
            "await": "tab:home"
          }
        ]
      },
      {
        "id": "search",
        "steps": [
          {
            "tap": "tab:search"
          }
        ]
      },
      {
        "id": "library",
        "steps": [
          {
            "tap": "tab:library"
          }
        ]
      },
      {
        "id": "albums",
        "steps": [
          {
            "tap": "library.show:albums"
          }
        ]
      },
      {
        "id": "album",
        "steps": [
          {
            "tap": "library.open-album:goldberg-variations-bwv-988"
          }
        ]
      },
      {
        "id": "player",
        "steps": [
          {
            "tap": "tab:library"
          },
          {
            "tap": "page.play-all:play"
          },
          {
            "await": "shell.open-player"
          },
          {
            "tap": "shell.open-player"
          },
          {
            "await": "player.toggle"
          },
          {
            "tap": "player.toggle"
          }
        ]
      },
      {
        "id": "settings",
        "steps": [
          {
            "tap": "shell.close-player"
          },
          {
            "tap": "shell.account"
          }
        ]
      }
    ]
  },
  "desktop": {
    "window": [
      1440,
      900
    ],
    "scale": 2,
    "shots": [
      {
        "id": "home",
        "steps": [
          {
            "await": "tab:home"
          }
        ]
      },
      {
        "id": "search",
        "steps": [
          {
            "tap": "tab:search"
          }
        ]
      },
      {
        "id": "library",
        "steps": [
          {
            "tap": "tab:library"
          }
        ]
      },
      {
        "id": "albums",
        "steps": [
          {
            "tap": "library.show:albums"
          }
        ]
      },
      {
        "id": "album",
        "steps": [
          {
            "tap": "library.open-album:goldberg-variations-bwv-988"
          }
        ]
      },
      {
        "id": "settings",
        "steps": [
          {
            "tap": "shell.account"
          }
        ]
      }
    ]
  },
  "hero": {
    "name": "Harken",
    "line": "Music, podcasts and sermons, from your own server, on every device",
    "logo": "harken/icon.svg",
    "screen": "home"
  },
  "launch": {
    "mac": [
      "-demo",
      "2026-11-18",
      "-window",
      "1440x900",
      "-ApplePersistenceIgnoreState",
      "YES"
    ]
  },
  "screens": [
    {
      "id": "home",
      "args": [
        "-screen",
        "home"
      ],
      "route": "/",
      "on": [
        "ios",
        "ipad-portrait",
        "ipad-landscape",
        "mac"
      ]
    },
    {
      "id": "library",
      "args": [
        "-screen",
        "library"
      ],
      "route": "/library/playlists/",
      "on": [
        "ios",
        "ipad-portrait",
        "ipad-landscape",
        "mac"
      ]
    },
    {
      "id": "albums",
      "args": [
        "-screen",
        "albums"
      ],
      "route": "/albums/",
      "on": [
        "ios",
        "ipad-portrait",
        "ipad-landscape",
        "mac"
      ]
    },
    {
      "id": "search",
      "args": [
        "-screen",
        "search"
      ],
      "route": "/search/",
      "on": [
        "ios",
        "ipad-portrait",
        "ipad-landscape",
        "mac"
      ]
    },
    {
      "id": "settings",
      "args": [
        "-screen",
        "settings"
      ],
      "route": "/settings/",
      "on": [
        "ios",
        "ipad-portrait",
        "ipad-landscape",
        "mac"
      ]
    },
    {
      "id": "welcome",
      "fresh": true,
      "route": "welcome/",
      "on": [
        "ios",
        "ipad-portrait",
        "ipad-landscape"
      ]
    }
  ],
  "web": {
    "_": "The browser's (app-web.sh, web-shots.js): harken-web over the demo library in the page (`query`'s `demo`: no server to sign in to), at each of `sizes` (named as `screens`' `on`) in light and dark; every one of `screens` is taken on the sizes it is `on`, its launch arguments as the page's address.",
    "query": "demo",
    "today": "2026-11-10",
    "sizes": {
      "mac": [
        1440,
        900
      ],
      "ipad-landscape": [
        1366,
        1024
      ],
      "ipad-portrait": [
        900,
        1100
      ],
      "ios": [
        400,
        860
      ]
    },
    "shots": [
      {
        "id": "command-box",
        "query": "command=Library"
      }
    ]
  }
}
