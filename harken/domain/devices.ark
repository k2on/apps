; The devices standing in a session: what each said it is, its volume, and
; where its scrubber is. Volume is per device; a device has none until it says
; it has one (`equip`).

; The devices standing in the account's session, in id order.
(query listening.devices_of
  ((user Text))
  (list (row listening_device))
  (filter listening_device (fn (entry) (== entry.user user))))

; A device standing in the session; refused when it is not (every caller has
; held it there first).
(query listening.present_of
  ((user Text) (device Text))
  Present
  (. (unwrap (get listening_device user device)) present))

; A device's entry, written.
(live listening.put_present
  ((user Text) (device Text) (present Present))
  (update listening_device
    user
    device
    (fn (entry) (record (user entry.user) (device entry.device) (present present)))))

; A device as `on_join` first writes it: what it declared, and nothing it has
; not said.
(helper listening.arrived
  ((device Device))
  Present
  (record (can_play device.can_play)
    (can_volume false)
    (family none)
    (follows none)
    (id device.id)
    (kind device.kind)
    (muted false)
    (name device.name)
    (user device.user)
    (volume 100)))

; Whether the device can have its volume moved: here, and said it has one.
(query listening.has_volume
  ((user Text) (device Text))
  Bool
  (?? (. (get listening_device user device) present can_volume) false))

; What a device says of itself once it stands here. A family that moves takes
; it out of any group it was in.
(live listening.equip
  ((input Equip))
  (if (none? (get listening_device ctx.user ctx.session)) (refuse "not here"))
  (if (!= (. (listening.present_of ctx.user ctx.session) family) input.family)
    (listening.dissolved ctx.user ctx.session))
  (let ((present (listening.present_of ctx.user ctx.session)))
    (listening.put_present ctx.user
      ctx.session
      (record (can_play present.can_play)
        (can_volume input.can_volume)
        (family input.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted input.muted)
        (name present.name)
        (user present.user)
        (volume input.volume)))))

; A device's volume, from anywhere. Moving the volume unmutes.
(live listening.set_volume
  ((input SetVolume))
  (if (not (listening.has_volume ctx.user input.device))
    (refuse "that device is not here, or has no volume"))
  (let ((present (listening.present_of ctx.user input.device)))
    (listening.put_present ctx.user
      input.device
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted false)
        (name present.name)
        (user present.user)
        (volume input.level)))))

; …moved by so much, clamped: what a volume button sends.
(live listening.nudge_volume
  ((input NudgeVolume))
  (if (not (listening.has_volume ctx.user input.device))
    (refuse "that device is not here, or has no volume"))
  (let ((present (listening.present_of ctx.user input.device)))
    (listening.put_present ctx.user
      input.device
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted false)
        (name present.name)
        (user present.user)
        (volume (clamp (+ present.volume input.delta) 0 100))))))

(live listening.set_mute
  ((input SetMute))
  (if (not (listening.has_volume ctx.user input.device))
    (refuse "that device is not here, or has no volume"))
  (let ((present (listening.present_of ctx.user input.device)))
    (listening.put_present ctx.user
      input.device
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted input.muted)
        (name present.name)
        (user present.user)
        (volume present.volume)))))

; The device's own word on its volume: its own entry only.
(live listening.report_volume
  ((input ReportVolume))
  (if (not (listening.has_volume ctx.user ctx.session)) (refuse "not here, or no volume"))
  (let ((present (listening.present_of ctx.user ctx.session)))
    (listening.put_present ctx.user
      ctx.session
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted input.muted)
        (name present.name)
        (user present.user)
        (volume input.level)))))

; Ephemeral: where this device's scrubber is being dragged to, or nowhere once
; it is let go. It reads nothing ordered and writes its own row.
(live listening.scrub
  ((input Scrub))
  (delete listening_scrub ctx.user ctx.session)
  (match input.at_ms
    (none () ())
    (some (ms) (insert listening_scrub (record (user ctx.user) (device ctx.session) (at_ms ms))))))

; * Coming and going

; A device arriving takes nothing; one the sound stayed with gets it back,
; still paused.
(live listening.on_join
  ((device Device))
  (let ((user device.user) (id device.id))
    (delete listening_device user id)
    (insert listening_device (record (user user) (device id) (present (listening.arrived device))))
    (let
      ((session
         (match (listening.session_of user)
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock active.clock)
                 (from active.from)
                 (output (listening.returned active.output id))
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (if (some? (get listening user)) (listening.put_session user session)))))

; A device leaving is gone, and so is its group; the output leaving keeps the
; sound, away, the clock stopped.
(live listening.on_leave
  ((device Device))
  (let ((user device.user) (id device.id))
    (listening.dissolved user id)
    (delete listening_device user id)
    (delete listening_scrub user id)
    (let
      ((session (listening.session_of user))
       (next
         (match session
           (Active (active)
             (if (listening.is_output session id)
               (Session.Active
                 (record (at active.at)
                   (clock (listening.halted active.clock active.output ctx.now))
                   (from active.from)
                   (output (Output.Away id device.name))
                   (queue active.queue)))
               session))
           (Idle () (Session.Idle)))))
      (if (some? (get listening user)) (listening.put_session user next)))))

; A restart: every queue as it was, paused where it had got to (never past the
; end of the track), with no output and nobody here. Authored over the ordered
; tables a restart kept; the scrubbers were never kept.
(live listening.on_restore
  ()
  (let () (map listening_device (fn (entry) (delete listening_device entry.user entry.device))) ())
  (let ()
    (map listening
      (fn (row)
        (let
          ((session
             (match row.session
               (Active (active)
                 (Session.Active
                   (record (at active.at)
                     (clock
                       (Clock.Paused
                         (min (listening.standing active.clock active.output ctx.now)
                           (listening.duration_at active.queue active.at))))
                     (from active.from)
                     (output (Output.Nowhere))
                     (queue active.queue))))
               (Idle () (Session.Idle)))))
          (listening.put_session row.user session))))
    ()))
