(schema
  (table media
    (id (id media) key)
    (kind Text)
    (title Text)
    (creator Text)
    (duration_ms Int)
    (file Text)
    (pos Int)
    (added_ms Int)
    (user_id Text)
    (index file)
    (index pos))
  (table album (name Text key) (label Text) (released Int) (art Text) (added_ms Int) (user_id Text))
  (table person
    (name Text key)
    (sort_name Text)
    (born Int)
    (died Int)
    (art Text)
    (added_ms Int)
    (user_id Text))
  (table work
    (id Text key)
    (composer Text (refs person))
    (title Text)
    (catalogue Text)
    (opus Text)
    (key_sig Text)
    (form Text)
    (period Text)
    (composed Int)
    (art Text)
    (added_ms Int)
    (user_id Text))
  (table movement
    (id Text key)
    (work_id Text (refs work))
    (no Int)
    (title Text)
    (part Text)
    (added_ms Int)
    (user_id Text))
  (table recording
    (id Text key)
    (work_id (option Text) (refs work))
    (recorded Int)
    (venue Text)
    (label Text)
    (licence Text)
    (art Text)
    (added_ms Int)
    (user_id Text))
  (table credit
    (recording_id Text key (refs recording))
    (person_name Text key (refs person))
    (role Text key)
    (instrument Text)
    (pos Int)
    (added_ms Int)
    (user_id Text))
  (table song
    (media_id (id media) key (refs media))
    (album_name (option Text) (refs album))
    (disc Int)
    (track Int)
    (recording_id Text (refs recording))
    (movement_id (option Text) (refs movement))
    (bpm Int))
  (table playlist
    (id (id playlist) key)
    (name Text)
    (pos Int)
    (created_ms Int)
    (user_id Text)
    (index unique user_id name)
    (index pos)
    (index user_id pos))
  (table playlist_item
    (playlist_id (id playlist) key (refs playlist))
    (media_id (id media) key (refs media))
    (pos Int)
    (added_ms Int)
    (user_id Text)
    (index playlist_id pos))
  (table play
    (id (id play) key)
    (user_id Text)
    (track Text)
    (title Text)
    (creator Text)
    (album Text)
    (duration_ms Int)
    (file Text)
    (played_ms Int)
    (from Text)
    (index user_id played_ms))
  (table listening volatile (user Text key) (session Session))
  (table listening_device volatile (user Text key) (device Text key) (present Present))
  (table listening_scrub volatile (user Text key) (device Text key) (at_ms Int)))

(type Active (record (at Int) (clock Clock) (from Text) (output Output) (queue (list Track))))

(type AddAllToPlaylist (record (playlist_id (id playlist))))

(type AddSong
  (record (title (where Text (trim) (non-empty) "a song needs a title"))
    (artist (where Text (trim)))
    (album (where Text (trim)))
    (duration_ms Int)
    (file (where Text (trim)))
    (track Int)
    (part (where Text (trim)))
    (catalogue (where Text (trim)))
    (performer (where Text (trim)))
    (bpm Int)
    (album_art (where Text (trim)))
    (artist_art (where Text (trim)))
    (disc Int)
    (work_title (where Text (trim)))
    (movement_no Int)))

(type AddToPlaylist (record (playlist_id (id playlist)) (media_id (id media))))

(type Advance (record (from_track Int)))

(type AlbumInput (record (playlist_id (id playlist)) (name Text)))

(type AlbumsEntry (record (art Text) (creator Text) (name Text) (tracks Int)))

(type Artist (record (playlist_id (id playlist)) (name Text)))

(type ArtistsEntry (record (art Text) (name Text) (tracks Int)))

(type At (record (at_ms (where Int (fn (n) (>= n 0))))))

(type Clock (sum (Paused (at_ms Int)) (Playing (at_ms Int) (since Int))))

(type ComposersEntry
  (record (art Text) (born Int) (died Int) (name Text) (sort_name Text) (tracks Int) (works Int)))

(type CreatePlaylist
  (record (name (where Text (trim) (non-empty) "a playlist needs a name" (len 0 120)))))

(type CreditRecording
  (record (recording_id Text)
    (person_name (where Text (trim) (non-empty) "a credit needs somebody to credit"))
    (role (where Text (trim)))
    (instrument (where Text (trim)))
    (pos Int)))

(type Credits (record (recording_id Text)))

(type CreditsEntry (record (instrument Text) (name Text) (pos Int) (role Text)))

(type DescribePerson
  (record (name (where Text (trim) (non-empty) "a person needs a name"))
    (sort_name (where Text (trim)))
    (born Int)
    (died Int)
    (art (where Text (trim)))))

(type DescribeRecording
  (record (id Text)
    (recorded Int)
    (venue (where Text (trim)))
    (label (where Text (trim)))
    (licence (where Text (trim)))
    (art (where Text (trim)))))

(type DescribeWork
  (record (id Text)
    (opus (where Text (trim)))
    (key_sig (where Text (trim)))
    (form (where Text (trim)))
    (period (where Text (trim)))
    (composed Int)
    (art (where Text (trim)))))

(type Device (record (can_play Bool) (id Text) (kind Text) (name Text) (user Text)))

(type Enqueue (record (next Bool) (tracks Queue)))

(type Equip
  (record (can_volume Bool)
    (family (option Family))
    (muted Bool)
    (volume (where Int (fn (n) (and (>= n 0) (<= n 100))) "between 0 and 100"))))

(type Family (where Text (len 1 ..)))

(type GroupMute (record (muted Bool)))

(type GroupNudge
  (record
    (delta
      (where Int
        (fn (n) (and (>= n -100) (<= n 100)))
        "between -100 and 100"
        (fn (n) (!= n 0))
        "a nudge moves the volume"))))

(type GroupVolume
  (record (level (where Int (fn (n) (and (>= n 0) (<= n 100))) "between 0 and 100"))))

(type Jump (record (index (where Int (fn (n) (>= n 0))))))

(type Library (record (playlist_id (id playlist))))

(type LibraryEntry
  (record (added_ms Int)
    (creator Text)
    (duration_ms Int)
    (file Text)
    (id (id media))
    (kind Text)
    (playlist_pos (option Int))
    (pos Int)
    (title Text)
    (user_id Text)))

(type Member (record (device Text)))

(type Move (record (from (where Int (fn (n) (>= n 0)))) (to (where Int (fn (n) (>= n 0))))))

(type Ms (where Int (fn (n) (>= n 0))))

(type NudgeVolume
  (record
    (delta
      (where Int
        (fn (n) (and (>= n -100) (<= n 100)))
        "between -100 and 100"
        (fn (n) (!= n 0))
        "a nudge moves the volume"))
    (device Text)))

(type Output (sum (Away (id Text) (name Text)) (Device (id Text) (moving Bool)) (Nowhere)))

(type PlaylistInput (record (playlist_id (id playlist))))

(type PlaylistsOf (record (media_id (id media))))

(type Present
  (record (can_play Bool)
    (can_volume Bool)
    (family (option Text))
    (follows (option Text))
    (id Text)
    (kind Text)
    (muted Bool)
    (name Text)
    (user Text)
    (volume Int)))

(type Queue (where (list Track) (non-empty)))

(type RecordPlay
  (record (track (id media))
    (title Text)
    (creator Text)
    (album Text)
    (duration_ms (where Int (fn (n) (>= n 0))))
    (file Text)
    (from Text)))

(type RecordingInput (record (playlist_id (id playlist)) (id Text)))

(type Recordings (record (work_id Text)))

(type RecordingsEntry
  (record (art Text)
    (id Text)
    (label Text)
    (licence Text)
    (performers Text)
    (recorded Int)
    (tracks Int)))

(type Remove (record (index (where Int (fn (n) (>= n 0))))))

(type RemoveFromPlaylist (record (playlist_id (id playlist)) (media_id (id media))))

(type RemoveMedia (record (id (id media))))

(type Report (record (at_ms (where Int (fn (n) (>= n 0)))) (since Int)))

(type ReportGroup (record (members (list Text))))

(type ReportVolume
  (record (level (where Int (fn (n) (and (>= n 0) (<= n 100))) "between 0 and 100")) (muted Bool)))

(type Scrub (record (at_ms (option Ms))))

(type Search (record (playlist_id (id playlist)) (needle Text)))

(type Seek (record (ms (where Int (fn (n) (>= n 0))))))

(type Session (sum (Active (active Active)) (Idle)))

(type SetMute (record (device Text) (muted Bool)))

(type SetVolume
  (record (device Text) (level (where Int (fn (n) (and (>= n 0) (<= n 100))) "between 0 and 100"))))

(type Skip
  (record
    (by
      (where Int
        (fn (n) (and (>= n -1) (<= n 1)))
        "a skip is one track either way"
        (fn (n) (!= n 0))
        "a skip is one track either way"))))

(type Start
  (record (at (where Int (fn (n) (>= n 0))))
    (from Text)
    (position (where Int (fn (n) (>= n 0))))
    (queue Queue)))

(type Tally (record (n Int) (sum Int)))

(type Track
  (record (album Text) (creator Text) (duration_ms Int) (file Text) (id (id media)) (title Text)))

(type TrackDetailsEntry
  (record (album Text)
    (bpm Int)
    (catalogue Text)
    (licence Text)
    (media_id (id media))
    (part Text)
    (performer Text)
    (track Int)))

(type Transfer (record (to Text)))

(type WorkInput (record (id Text)))

(type WorkSummary
  (record (art Text)
    (catalogue Text)
    (composer Text)
    (form Text)
    (id Text)
    (period Text)
    (recordings Int)
    (title Text)
    (tracks Int)))

(type Works (record (composer Text)))

(mutator library.add_song
  ((add_song AddSong))
  (library.is_library)
  (let
    ((opt
       (match (first (filter media (fn (m) (== m.file add_song.file))))
         (none () (as (option (row media)) none))
         (some (m) (if (not (is-empty m.file)) (some m) (as (option (row media)) none)))))
     (media_id (?? opt.id (new-id media)))
     (x (first (sort media (fn (m) (desc m.pos)))))
     (x2
       (tuple media_id
         (?? opt.kind "song")
         add_song.title
         add_song.artist
         add_song.duration_ms
         add_song.file
         (?? opt.pos (+ (?? x.pos 0) 1))
         (?? opt.added_ms ctx.now)
         (?? opt.user_id ctx.user))))
    (if (some? (get media media_id)) (update media media_id (fn (m) x2)) (insert media x2))
    (if (not (is-empty add_song.album))
      (let ((x3 (get album add_song.album)))
        (if
          (match x3
            (none () true)
            (some (a) (and (not (is-empty add_song.album_art)) (!= a.art add_song.album_art))))
          (let
            ((x4
               (tuple add_song.album
                 (?? x3.label "")
                 (?? x3.released 0)
                 add_song.album_art
                 ctx.now
                 ctx.user)))
            (if (some? x3) (update album add_song.album (fn (a) x4)) (insert album x4))))))
    (if (not (is-empty add_song.artist))
      (let ((x3 (get person add_song.artist)))
        (if
          (match x3
            (none () true)
            (some (p) (and (not (is-empty add_song.artist_art)) (!= p.art add_song.artist_art))))
          (let
            ((x4
               (tuple add_song.artist
                 (?? x3.sort_name "")
                 (?? x3.born 0)
                 (?? x3.died 0)
                 add_song.artist_art
                 (?? x3.added_ms ctx.now)
                 (?? x3.user_id ctx.user))))
            (if (some? x3) (update person add_song.artist (fn (p) x4)) (insert person x4))))))
    (let
      ((text
         (library.work_title add_song.work_title add_song.album add_song.catalogue add_song.part))
       (opt2 (library.work_id add_song.artist add_song.catalogue text)))
      (if (some? opt2)
        (let
          ((text2 (library.work_key add_song.artist add_song.catalogue text))
           (n (if (== add_song.movement_no 0) add_song.track add_song.movement_no))
           (text3 (library.movement_key text2 n))
           (x3 (get work text2))
           (x4
             (tuple text2
               add_song.artist
               text
               add_song.catalogue
               (?? x3.opus "")
               (?? x3.key_sig "")
               (?? x3.form "")
               (?? x3.period "")
               (?? x3.composed 0)
               (?? x3.art "")
               (?? x3.added_ms ctx.now)
               (?? x3.user_id ctx.user))))
          (if (some? x3) (update work text2 (fn (w) x4)) (insert work x4))
          (let
            ((x5 (get movement text3))
             (x6
               (tuple text3
                 text2
                 n
                 add_song.title
                 add_song.part
                 (?? x5.added_ms ctx.now)
                 (?? x5.user_id ctx.user))))
            (if (some? x5) (update movement text3 (fn (m) x6)) (insert movement x6)))))
      (let
        ((text2
           (library.recording_id opt2
             add_song.album
             add_song.title
             add_song.artist
             add_song.performer))
         (text3 (library.credited_as opt2 add_song.artist add_song.performer)))
        (if (none? (get recording text2))
          (insert recording
            (record (id text2)
              (work_id opt2)
              (recorded 0)
              (venue "")
              (label "")
              (licence "")
              (art "")
              (added_ms ctx.now)
              (user_id ctx.user))))
        (if (not (is-empty text3))
          (let ()
            (if (none? (get person text3))
              (insert person
                (record (name text3)
                  (sort_name "")
                  (born 0)
                  (died 0)
                  (art "")
                  (added_ms ctx.now)
                  (user_id ctx.user))))
            (let ((text4 (if (some? opt2) "performer" "artist")))
              (if (none? (get credit text2 text3 text4))
                (insert credit
                  (record (recording_id text2)
                    (person_name text3)
                    (role text4)
                    (instrument "")
                    (pos 0)
                    (added_ms ctx.now)
                    (user_id ctx.user)))))))
        (let
          ((opt3 (library.movement_id opt2 add_song.movement_no add_song.track))
           (x3 (get song media_id))
           (s
             (tuple media_id
               (if (is-empty add_song.album) (as (option Text) none) (some add_song.album))
               (if (> add_song.disc 0) (min add_song.disc 99) 1)
               (clamp add_song.track 0 999)
               text2
               opt3
               (if (and (>= add_song.bpm 20) (<= add_song.bpm 300)) add_song.bpm 0))))
          (if (some? x3) (update song media_id (fn (s2) s)) (insert song s))
          (let
            ((opt4
               (match (?. x3 recording_id)
                 (none () (as (option Text) none))
                 (some (text4) (if (!= text4 text2) (some text4) (as (option Text) none))))))
            (if
              (and (some? opt4)
                (== (len (filter song (fn (s2) (== s2.recording_id (unwrap opt4))))) 0))
              (let ()
                (let ()
                  (map (filter credit (fn (c) (== c.recording_id (unwrap opt4))))
                    (fn (c) (delete credit c.recording_id c.person_name c.role)))
                  ())
                (delete recording (unwrap opt4))))
            (let
              ((opt5
                 (match (?? x3.movement_id none)
                   (none () (as (option Text) none))
                   (some (text4) (if (!= (some text4) opt3) (some text4) (as (option Text) none))))))
              (if (and (some? opt5) (== (len (filter song (fn (s2) (== s2.movement_id opt5)))) 0))
                (let ((text4 (?? (. (get movement (unwrap opt5)) work_id) "")))
                  (delete movement (unwrap opt5))
                  (if
                    (and (== (len (filter movement (fn (m) (== m.work_id text4)))) 0)
                      (== (len (filter recording (fn (r) (== r.work_id (some text4))))) 0))
                    (delete work text4)))))))))))

(query library.album
  ((album_input AlbumInput))
  (list LibraryEntry)
  (map
    (sort
      (filter song
        (fn (s) (and (== s.album_name (some album_input.name)) (some? (get media s.media_id)))))
      (fn (s)
        (tuple (?? (. (library.movement_of s) part) "")
          (== s.track 0)
          s.track
          (?? (. (get media s.media_id) title) ""))))
    (fn (s)
      (library.library_entry (unwrap (get media s.media_id))
        (library.playlist_pos album_input.playlist_id s.media_id)))))

(query library.albums
  ()
  (list AlbumsEntry)
  (map
    (filter
      (map album
        (fn (a)
          (tuple a
            (map (filter song (fn (s) (== s.album_name (some a.name))))
              (fn (s) (?? (. (get media s.media_id) creator) ""))))))
      (fn (x) (> (len x.1) 0)))
    (fn (x) (tuple x.0.art (?? (first x.1) "") x.0.name (len x.1)))))

(query library.artist
  ((artist Artist))
  (list LibraryEntry)
  (map (sort (filter media (fn (m) (== m.creator artist.name))) (fn (m) m.pos))
    (fn (m) (library.library_entry m (library.playlist_pos artist.playlist_id m.id)))))

(query library.artists
  ()
  (list ArtistsEntry)
  (map
    (group media
      (fn (m) m.creator)
      (fn (text xs) (tuple (?? (. (get person text) art) "") text (len xs))))
    (fn (x) x.1)))

(query library.composers
  ()
  (list ComposersEntry)
  (map
    (filter
      (map person
        (fn (p)
          (tuple p
            (map (filter work (fn (w) (== w.composer p.name))) (fn (w) (library.work_tracks w.id))))))
      (fn (x) (> (len x.1) 0)))
    (fn (x)
      (tuple x.0.art
        x.0.born
        x.0.died
        x.0.name
        (if (is-empty x.0.sort_name) x.0.name x.0.sort_name)
        (library.total x.1)
        (len x.1)))))

(mutator library.credit_recording
  ((credit_recording CreditRecording))
  (library.is_library)
  (if (none? (get recording credit_recording.recording_id))
    (refuse (concat (list "no recording " credit_recording.recording_id " to credit anybody on"))))
  (if (none? (get person credit_recording.person_name))
    (insert person
      (record (name credit_recording.person_name)
        (sort_name "")
        (born 0)
        (died 0)
        (art "")
        (added_ms ctx.now)
        (user_id ctx.user))))
  (let
    ((text (if (is-empty credit_recording.role) "artist" credit_recording.role))
     (x (get credit credit_recording.recording_id credit_recording.person_name text))
     (x2
       (tuple credit_recording.recording_id
         credit_recording.person_name
         text
         (if (is-empty credit_recording.instrument)
           (?? x.instrument "")
           credit_recording.instrument)
         (if (== credit_recording.pos 0) (max (?? x.pos 0) 1) (max credit_recording.pos 1))
         ctx.now
         ctx.user)))
    (if (some? x)
      (update credit credit_recording.recording_id credit_recording.person_name text (fn (c) x2))
      (insert credit x2))))

(helper library.credited
  ((xs (list (row credit))))
  (list (row credit))
  (filter xs (fn (c) (or (> c.pos 0) (== (len (filter xs (fn (c2) (> c2.pos 0)))) 0)))))

(helper library.credited_as
  ((opt (option Text)) (text Text) (text2 Text))
  Text
  (if (is-empty text2) (if (some? opt) "" text) text2))

(query library.credits
  ((credits Credits))
  (list CreditsEntry)
  (let ((xs (filter credit (fn (c) (== c.recording_id credits.recording_id)))))
    (map (sort (library.credited xs) (fn (c) (tuple c.pos c.person_name)))
      (fn (c) (tuple c.instrument c.person_name c.pos c.role)))))

(mutator library.describe_person
  ((describe_person DescribePerson))
  (library.is_library)
  (let
    ((x (get person describe_person.name))
     (x2
       (tuple describe_person.name
         (if (is-empty describe_person.sort_name) (?? x.sort_name "") describe_person.sort_name)
         (if (== describe_person.born 0) (?? x.born 0) describe_person.born)
         (if (== describe_person.died 0) (?? x.died 0) describe_person.died)
         (if (is-empty describe_person.art) (?? x.art "") describe_person.art)
         (?? x.added_ms ctx.now)
         (?? x.user_id ctx.user))))
    (if (some? x) (update person describe_person.name (fn (p) x2)) (insert person x2))))

(mutator library.describe_recording
  ((describe_recording DescribeRecording))
  (library.is_library)
  (if (none? (get recording describe_recording.id))
    (refuse
      (concat
        (list "no recording " describe_recording.id "; one exists because a song is part of it"))))
  (update recording
    describe_recording.id
    (fn (r)
      (record (id r.id)
        (work_id r.work_id)
        (recorded (if (== describe_recording.recorded 0) r.recorded describe_recording.recorded))
        (venue (if (is-empty describe_recording.venue) r.venue describe_recording.venue))
        (label (if (is-empty describe_recording.label) r.label describe_recording.label))
        (licence (if (is-empty describe_recording.licence) r.licence describe_recording.licence))
        (art (if (is-empty describe_recording.art) r.art describe_recording.art))
        (added_ms ctx.now)
        (user_id r.user_id)))))

(mutator library.describe_work
  ((describe_work DescribeWork))
  (library.is_library)
  (if (none? (get work describe_work.id))
    (refuse (concat (list "no work " describe_work.id "; a work exists because a song named it"))))
  (update work
    describe_work.id
    (fn (w)
      (record (id w.id)
        (composer w.composer)
        (title w.title)
        (catalogue w.catalogue)
        (opus (if (is-empty describe_work.opus) w.opus describe_work.opus))
        (key_sig (if (is-empty describe_work.key_sig) w.key_sig describe_work.key_sig))
        (form (if (is-empty describe_work.form) w.form describe_work.form))
        (period (if (is-empty describe_work.period) w.period describe_work.period))
        (composed (if (== describe_work.composed 0) w.composed describe_work.composed))
        (art (if (is-empty describe_work.art) w.art describe_work.art))
        (added_ms ctx.now)
        (user_id w.user_id)))))

(helper library.has
  ((text Text) (text2 Text))
  Bool
  (or (is-empty text2) (some? (split-once (lower text) (lower text2)))))

(helper library.is_library
  ()
  (tuple)
  (if (not (has-role "library")) (refuse "only the library writes the library")))

(helper library.joined
  ((xs (list Text)))
  Text
  (?? (. (split-once (concat (map xs (fn (text) (concat (list ", " text))))) ", ") 1) ""))

(helper library.key_part
  ((text Text))
  Text
  (let ((text2 (library.slug text)))
    (if (is-empty text2) (concat (list "x" (to-text (fnv1a64 (trim text))))) text2)))

(query library.library
  ((library2 Library))
  (list LibraryEntry)
  (map (sort media (fn (m) m.pos))
    (fn (m) (library.library_entry m (library.playlist_pos library2.playlist_id m.id)))))

(helper library.library_entry
  ((m (row media)) (opt (option Int)))
  LibraryEntry
  (record (added_ms m.added_ms)
    (creator m.creator)
    (duration_ms m.duration_ms)
    (file m.file)
    (id m.id)
    (kind m.kind)
    (playlist_pos opt)
    (pos m.pos)
    (title m.title)
    (user_id m.user_id)))

(helper library.movement_id
  ((opt (option Text)) (n Int) (n2 Int))
  (option Text)
  (match opt (none () none) (some (text) (some (library.movement_key text (if (== n 0) n2 n))))))

(helper library.movement_key ((text Text) (n Int)) Text (concat (list text "#" (to-text n))))

(query library.movement_of
  ((s (row song)))
  (option (row movement))
  (match s.movement_id (none () none) (some (text) (get movement text))))

(helper library.performers
  ((xs (list (row credit))) (text Text))
  Text
  (library.joined
    (map
      (sort
        (library.credited (filter xs (fn (c) (and (== c.recording_id text) (!= c.role "composer")))))
        (fn (c) (tuple c.pos c.person_name)))
      (fn (c) c.person_name))))

(query library.playlist_pos
  ((playlist_id (id playlist)) (media_id (id media)))
  (option Int)
  (?. (get playlist_item playlist_id media_id) pos))

(query library.recording
  ((recording_input RecordingInput))
  (list LibraryEntry)
  (map
    (sort
      (filter song
        (fn (s) (and (== s.recording_id recording_input.id) (some? (get media s.media_id)))))
      (fn (s)
        (tuple (none? s.movement_id)
          (?? (. (library.movement_of s) no) 0)
          (?? (. (get media s.media_id) title) ""))))
    (fn (s)
      (library.library_entry (unwrap (get media s.media_id))
        (library.playlist_pos recording_input.playlist_id s.media_id)))))

(helper library.recording_id
  ((opt (option Text)) (text Text) (text2 Text) (text3 Text) (text4 Text))
  Text
  (library.recording_key
    (?? opt (concat (list (library.key_part text) "/" (library.key_part text2))))
    (if (is-empty text4) text3 text4)))

(helper library.recording_key
  ((text Text) (text2 Text))
  Text
  (concat (list text "@" (library.key_part text2))))

(query library.recordings
  ((recordings Recordings))
  (list RecordingsEntry)
  (map
    (sort
      (map (filter recording (fn (r) (== r.work_id (some recordings.work_id))))
        (fn (r) (tuple r (len (filter song (fn (s) (== s.recording_id r.id)))))))
      (fn (x) (tuple (- x.1) x.0.recorded)))
    (fn (x)
      (tuple x.0.art
        x.0.id
        x.0.label
        x.0.licence
        (library.performers (filter credit (fn (c) (== c.recording_id x.0.id))) x.0.id)
        x.0.recorded
        x.1))))

(mutator library.remove_media
  ((remove_media RemoveMedia))
  (library.is_library)
  (let ()
    (map (filter playlist_item (fn (pi) (== pi.media_id remove_media.id)))
      (fn (pi) (delete playlist_item pi.playlist_id pi.media_id)))
    ())
  (delete song remove_media.id)
  (delete media remove_media.id))

(query library.search
  ((search Search))
  (list LibraryEntry)
  (map
    (sort
      (filter media
        (fn (m) (or (library.has m.title search.needle) (library.has m.creator search.needle))))
      (fn (m) m.pos))
    (fn (m) (library.library_entry m (library.playlist_pos search.playlist_id m.id)))))

(helper library.slug
  ((text Text))
  Text
  (let
    ((text2 (trim (concat (map (chars text) (fn (text2) (if (is-alnum text2) (lower text2) " ")))))))
    (concat (map (chars text2) (fn (text3) (if (== text3 " ") "-" text3))))))

(query library.summaries
  ((xs (list (row work))))
  (list WorkSummary)
  (map xs
    (fn (w)
      (library.work_summary w
        (len (filter recording (fn (r) (== r.work_id (some w.id)))))
        (library.work_tracks w.id)))))

(helper library.total ((xs (list Int))) Int (sum xs))

(query library.track_details
  ()
  (list TrackDetailsEntry)
  (map song
    (fn (s)
      (let
        ((opt (library.movement_of s))
         (x (match opt (none () (as (option (row work)) none)) (some (m) (get work m.work_id))))
         (x2 (get recording s.recording_id)))
        (tuple (?? s.album_name "")
          s.bpm
          (?? x.catalogue "")
          (?? x2.licence "")
          s.media_id
          (?? opt.part "")
          (library.performers (filter credit (fn (c) (== c.recording_id s.recording_id)))
            s.recording_id)
          s.track)))))

(query library.work
  ((work_input WorkInput))
  (list WorkSummary)
  (library.summaries (filter work (fn (w) (== w.id work_input.id)))))

(helper library.work_id
  ((text Text) (text2 Text) (text3 Text))
  (option Text)
  (if (or (is-empty text3) (is-empty text)) none (some (library.work_key text text2 text3))))

(helper library.work_key
  ((text Text) (text2 Text) (text3 Text))
  Text
  (concat (list (library.key_part text) "/" (library.key_part (if (is-empty text2) text3 text2)))))

(helper library.work_summary
  ((w (row work)) (n Int) (n2 Int))
  WorkSummary
  (record (art w.art)
    (catalogue w.catalogue)
    (composer w.composer)
    (form w.form)
    (id w.id)
    (period w.period)
    (recordings n)
    (title w.title)
    (tracks n2)))

(helper library.work_title
  ((text Text) (text2 Text) (text3 Text) (text4 Text))
  Text
  (if (and (is-empty text) (or (not (is-empty text3)) (not (is-empty text4)))) text2 text))

(query library.work_tracks
  ((text Text))
  Int
  (library.total
    (map (filter movement (fn (m) (== m.work_id text)))
      (fn (m) (len (filter song (fn (s) (== s.movement_id (some m.id)))))))))

(query library.works
  ((works Works))
  (list WorkSummary)
  (library.summaries
    (sort (filter work (fn (w) (== w.composer works.composer)))
      (fn (w) (tuple w.catalogue w.title)))))

(live listening.advance
  ((advance Advance))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((session2
         (match session
           (Active (active)
             (if (!= active.at advance.from_track)
               session
               (if (< (+ active.at 1) (len active.queue))
                 (Session.Active
                   (record (at (+ active.at 1))
                     (clock (Clock.Playing 0 ctx.now))
                     (from active.from)
                     (output active.output)
                     (queue active.queue)))
                 (Session.Active
                   (record (at active.at)
                     (clock (Clock.Paused 0))
                     (from active.from)
                     (output active.output)
                     (queue active.queue))))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(helper listening.arrived
  ((device Device))
  Present
  (record (can_play device.can_play)
    (can_volume false)
    (family none)
    (follows none)
    (id device.id)
    (kind device.kind)
    (muted false)
    (name device.name)
    (user device.user)
    (volume 100)))

(query listening.can_play
  ((text Text) (text2 Text))
  Bool
  (?? (. (get listening_device text text2) present can_play) false))

(live listening.clear_upcoming
  ()
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (let
      ((session2
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock active.clock)
                 (from active.from)
                 (output active.output)
                 (queue (slice active.queue 0 (min (+ active.at 1) (len active.queue)))))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(helper listening.clock_at
  ((clock Clock) (n Int) (n2 Int))
  Clock
  (match clock (Paused (at_ms) (Clock.Paused n)) (Playing (at_ms since) (Clock.Playing n n2))))

(query listening.devices_of
  ((text Text))
  (list (row listening_device))
  (filter listening_device (fn (ld) (== ld.user text))))

(live listening.dissolved
  ((text Text) (text2 Text))
  (map
    (filter (listening.devices_of text)
      (fn (ld) (or (== ld.present.id text2) (== ld.present.follows (some text2)))))
    (fn (ld)
      (listening.put_present text
        ld.device
        (record (can_play ld.present.can_play)
          (can_volume ld.present.can_volume)
          (family ld.present.family)
          (follows none)
          (id ld.present.id)
          (kind ld.present.kind)
          (muted ld.present.muted)
          (name ld.present.name)
          (user ld.present.user)
          (volume ld.present.volume)))))
  ())

(helper listening.duration_at
  ((xs (list Track)) (n Int))
  Int
  (if (and (>= n 0) (< n (len xs))) (?? (. (first (slice xs n (+ n 1))) duration_ms) 0) 0))

(live listening.enqueue
  ((enqueue Enqueue))
  (let ((session (listening.session_of ctx.user)))
    (if (not (or (listening.is_active session) (listening.can_play ctx.user ctx.session)))
      (refuse "nothing here can play it"))
    (let
      ((session2
         (match session
           (Active (active)
             (let ((n (len active.queue)) (n2 (min (if enqueue.next (+ active.at 1) n) n)))
               (Session.Active
                 (record (at active.at)
                   (clock active.clock)
                   (from active.from)
                   (output active.output)
                   (queue
                     (concat (concat (slice active.queue 0 n2) enqueue.tracks)
                       (slice active.queue n2 n)))))))
           (Idle ()
             (Session.Active
               (record (at 0)
                 (clock (Clock.Playing 0 ctx.now))
                 (from "")
                 (output (listening.here ctx.session))
                 (queue enqueue.tracks)))))))
      (listening.put_session ctx.user session2))))

(live listening.equip
  ((equip Equip))
  (if (none? (get listening_device ctx.user ctx.session)) (refuse "not here"))
  (if (!= (. (listening.present_of ctx.user ctx.session) family) equip.family)
    (listening.dissolved ctx.user ctx.session))
  (let ((present (listening.present_of ctx.user ctx.session)))
    (listening.put_present ctx.user
      ctx.session
      (record (can_play present.can_play)
        (can_volume equip.can_volume)
        (family equip.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted equip.muted)
        (name present.name)
        (user present.user)
        (volume equip.volume)))))

(live listening.followed
  ((text Text) (text2 Text) (text3 Text))
  (map (listening.devices_of text)
    (fn (ld)
      (if (== ld.present.id text2)
        (listening.put_present text
          ld.device
          (record (can_play ld.present.can_play)
            (can_volume ld.present.can_volume)
            (family ld.present.family)
            (follows (some text3))
            (id ld.present.id)
            (kind ld.present.kind)
            (muted ld.present.muted)
            (name ld.present.name)
            (user ld.present.user)
            (volume ld.present.volume)))
        (if (== ld.present.follows (some text2))
          (listening.put_present text
            ld.device
            (record (can_play ld.present.can_play)
              (can_volume ld.present.can_volume)
              (family ld.present.family)
              (follows none)
              (id ld.present.id)
              (kind ld.present.kind)
              (muted ld.present.muted)
              (name ld.present.name)
              (user ld.present.user)
              (volume ld.present.volume)))))))
  ())

(live listening.group_at
  ((text Text) (text2 Text) (n Int))
  (let ((n2 (listening.group_level text text2)))
    (map (listening.voiced text text2)
      (fn (ld)
        (listening.put_present text
          ld.device
          (record (can_play ld.present.can_play)
            (can_volume ld.present.can_volume)
            (family ld.present.family)
            (follows ld.present.follows)
            (id ld.present.id)
            (kind ld.present.kind)
            (muted false)
            (name ld.present.name)
            (user ld.present.user)
            (volume (listening.scaled ld.present.volume n2 n))))))
    ()))

(query listening.group_has_volume
  ((text Text))
  Bool
  (match (listening.output_id (listening.session_of text))
    (none () false)
    (some (text2) (> (. (listening.group_tally text text2) n) 0))))

(query listening.group_level
  ((text Text) (text2 Text))
  Int
  (let ((tally (listening.group_tally text text2))) (/ tally.sum (max tally.n 1))))

(live listening.group_muted
  ((text Text) (text2 Text) (b Bool))
  (map (listening.voiced text text2)
    (fn (ld)
      (listening.put_present text
        ld.device
        (record (can_play ld.present.can_play)
          (can_volume ld.present.can_volume)
          (family ld.present.family)
          (follows ld.present.follows)
          (id ld.present.id)
          (kind ld.present.kind)
          (muted b)
          (name ld.present.name)
          (user ld.present.user)
          (volume ld.present.volume)))))
  ())

(query listening.group_tally
  ((text Text) (text2 Text))
  Tally
  (let ((xs (listening.voiced text text2)))
    (record (n (len xs)) (sum (sum (map xs (fn (ld) ld.present.volume)))))))

(helper listening.halt
  ((session Session) (n Int))
  Session
  (match session
    (Active (active)
      (Session.Active
        (record (at active.at)
          (clock (listening.halted active.clock active.output n))
          (from active.from)
          (output active.output)
          (queue active.queue))))
    (Idle () (Session.Idle))))

(helper listening.halted
  ((clock Clock) (output Output) (n Int))
  Clock
  (Clock.Paused (listening.standing clock output n)))

(query listening.has_volume
  ((text Text) (text2 Text))
  Bool
  (?? (. (get listening_device text text2) present can_volume) false))

(helper listening.here ((text Text)) Output (Output.Device text false))

(helper listening.in_group
  ((present Present) (text Text))
  Bool
  (or (== present.id text) (== present.follows (some text))))

(helper listening.in_queue
  ((session Session) (n Int))
  Bool
  (match session (Active (active) (< n (len active.queue))) (Idle () false)))

(helper listening.is_active
  ((session Session))
  Bool
  (match session (Active (active) true) (Idle () false)))

(helper listening.is_here
  ((output Output))
  Bool
  (match output (Away (id name) false) (Device (id moving) true) (Nowhere () false)))

(helper listening.is_output
  ((session Session) (text Text))
  Bool
  (match session
    (Active (active)
      (match active.output
        (Away (id name) false)
        (Device (id moving) (== id text))
        (Nowhere () false)))
    (Idle () false)))

(live listening.join
  ((member Member))
  (let ((opt (listening.output_id (listening.session_of ctx.user))))
    (if (none? opt) (refuse "nothing is playing to join"))
    (if
      (not
        (match opt (none () false) (some (text) (listening.joinable ctx.user text member.device))))
      (refuse "that device cannot join this one"))
    (listening.followed ctx.user member.device (unwrap opt))))

(query listening.joinable
  ((text Text) (text2 Text) (text3 Text))
  Bool
  (let
    ((opt
       (match (get listening_device text text2)
         (none () (as (option Text) none))
         (some (ld) (if (none? ld.present.follows) ld.present.family (as (option Text) none))))))
    (match (get listening_device text text3)
      (none () false)
      (some (ld)
        (and (and (and (!= ld.present.id text2) ld.present.can_play) (some? ld.present.family))
          (== ld.present.family opt))))))

(live listening.jump
  ((jump Jump))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (if (not (listening.in_queue session jump.index)) (refuse "the track is not in the queue"))
    (if (not (or (listening.reachable session) (listening.can_play ctx.user ctx.session)))
      (refuse "nothing here can play it"))
    (let
      ((session2
         (match session
           (Active (active) (listening.moved_to active jump.index ctx.session ctx.now))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(query listening.last_played
  ()
  (list (row play))
  (take
    (sort (filter play (fn (p) (== p.user_id ctx.user)))
      (fn (p) (tuple (desc p.played_ms) (desc p.id))))
    1))

(query listening.leader
  ((text Text))
  Text
  (unwrap (listening.output_id (listening.session_of text))))

(live listening.led_by
  ((text Text) (text2 Text))
  (let ((opt (?? (. (get listening_device text text2) present follows) none)))
    (map (listening.devices_of text)
      (fn (ld)
        (if (== ld.present.id text2)
          (listening.put_present text
            ld.device
            (record (can_play ld.present.can_play)
              (can_volume ld.present.can_volume)
              (family ld.present.family)
              (follows none)
              (id ld.present.id)
              (kind ld.present.kind)
              (muted ld.present.muted)
              (name ld.present.name)
              (user ld.present.user)
              (volume ld.present.volume)))
          (if (and (some? opt) (or (== (some ld.present.id) opt) (== ld.present.follows opt)))
            (listening.put_present text
              ld.device
              (record (can_play ld.present.can_play)
                (can_volume ld.present.can_volume)
                (family ld.present.family)
                (follows (some text2))
                (id ld.present.id)
                (kind ld.present.kind)
                (muted ld.present.muted)
                (name ld.present.name)
                (user ld.present.user)
                (volume ld.present.volume)))))))
    ()))

(live listening.move
  ((move Move))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (if (not (and (listening.in_queue session move.from) (listening.in_queue session move.to)))
      (refuse "the track is not in the queue"))
    (let
      ((session2
         (match session
           (Active (active)
             (Session.Active
               (record (at (listening.moved_place active.at move.from move.to))
                 (clock active.clock)
                 (from active.from)
                 (output active.output)
                 (queue (move-at active.queue move.from move.to)))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(helper listening.moved_place
  ((n Int) (n2 Int) (n3 Int))
  Int
  (if (== n n2)
    n3
    (if (and (and (< n2 n3) (> n n2)) (<= n n3))
      (- n 1)
      (if (and (and (< n3 n2) (>= n n3)) (< n n2)) (+ n 1) n))))

(helper listening.moved_to
  ((active Active) (n Int) (text Text) (n2 Int))
  Session
  (Session.Active
    (record (at n)
      (clock (Clock.Playing 0 n2))
      (from active.from)
      (output (listening.pressed active.output text))
      (queue active.queue))))

(live listening.nudge_group_volume
  ((group_nudge GroupNudge))
  (if (not (listening.group_has_volume ctx.user)) (refuse "nothing playing has a volume"))
  (let ((text (listening.leader ctx.user)))
    (listening.group_at ctx.user
      text
      (clamp (+ (listening.group_level ctx.user text) group_nudge.delta) 0 100))))

(live listening.nudge_volume
  ((nudge_volume NudgeVolume))
  (if (not (listening.has_volume ctx.user nudge_volume.device))
    (refuse "that device is not here, or has no volume"))
  (let ((present (listening.present_of ctx.user nudge_volume.device)))
    (listening.put_present ctx.user
      nudge_volume.device
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted false)
        (name present.name)
        (user present.user)
        (volume (clamp (+ present.volume nudge_volume.delta) 0 100))))))

(live listening.on_join
  ((device Device))
  (let ((text device.user) (text2 device.id))
    (delete listening_device text text2)
    (insert listening_device
      (record (user text) (device text2) (present (listening.arrived device))))
    (let
      ((session
         (match (listening.session_of text)
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock active.clock)
                 (from active.from)
                 (output (listening.returned active.output text2))
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (if (some? (get listening text)) (listening.put_session text session)))))

(live listening.on_leave
  ((device Device))
  (let ((text device.user) (text2 device.id))
    (listening.dissolved text text2)
    (delete listening_device text text2)
    (delete listening_scrub text text2)
    (let
      ((session (listening.session_of text))
       (session2
         (match session
           (Active (active)
             (if (listening.is_output session text2)
               (Session.Active
                 (record (at active.at)
                   (clock (listening.halted active.clock active.output ctx.now))
                   (from active.from)
                   (output (Output.Away text2 device.name))
                   (queue active.queue)))
               session))
           (Idle () (Session.Idle)))))
      (if (some? (get listening text)) (listening.put_session text session2)))))

(live listening.on_restore
  ()
  (let () (map listening_device (fn (ld) (delete listening_device ld.user ld.device))) ())
  (let ()
    (map listening
      (fn (l)
        (let
          ((session
             (match l.session
               (Active (active)
                 (Session.Active
                   (record (at active.at)
                     (clock
                       (Clock.Paused
                         (min (listening.standing active.clock active.output ctx.now)
                           (listening.duration_at active.queue active.at))))
                     (from active.from)
                     (output (Output.Nowhere))
                     (queue active.queue))))
               (Idle () (Session.Idle)))))
          (listening.put_session l.user session))))
    ()))

(helper listening.output_id
  ((session Session))
  (option Text)
  (match session
    (Active (active)
      (match active.output (Away (id name) none) (Device (id moving) (some id)) (Nowhere () none)))
    (Idle () none)))

(live listening.pause
  ()
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (listening.put_session ctx.user (listening.halt session ctx.now))))

(live listening.play
  ()
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (if (not (or (listening.reachable session) (listening.can_play ctx.user ctx.session)))
      (refuse "nothing here can play it"))
    (let
      ((session2
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock
                   (Clock.Playing (listening.standing active.clock active.output ctx.now) ctx.now))
                 (from active.from)
                 (output (listening.pressed active.output ctx.session))
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(helper listening.position
  ((clock Clock) (n Int))
  Int
  (match clock (Paused (at_ms) at_ms) (Playing (at_ms since) (max (+ at_ms (- n since)) at_ms))))

(query listening.present_of
  ((text Text) (text2 Text))
  Present
  (. (unwrap (get listening_device text text2)) present))

(helper listening.pressed
  ((output Output) (text Text))
  Output
  (if (listening.is_here output) output (listening.here text)))

(live listening.put_present
  ((text Text) (text2 Text) (present Present))
  (update listening_device
    text
    text2
    (fn (ld) (record (user ld.user) (device ld.device) (present present)))))

(live listening.put_session
  ((text Text) (session Session))
  (if (some? (get listening text))
    (update listening text (fn (l) (record (user l.user) (session session))))
    (insert listening (record (user text) (session session)))))

(helper listening.reachable
  ((session Session))
  Bool
  (match session (Active (active) (listening.is_here active.output)) (Idle () false)))

(query listening.recently_played
  ()
  (list (row play))
  (take
    (sort (filter play (fn (p) (== p.user_id ctx.user)))
      (fn (p) (tuple (desc p.played_ms) (desc p.id))))
    50))

(mutator listening.record_play
  ((record_play RecordPlay))
  (insert play
    (record (id (new-id play))
      (user_id ctx.user)
      (track (text-of-id record_play.track))
      (title record_play.title)
      (creator record_play.creator)
      (album record_play.album)
      (duration_ms record_play.duration_ms)
      (file record_play.file)
      (played_ms ctx.now)
      (from record_play.from))))

(live listening.regrouped
  ((text Text) (text2 Text) (xs (list Text)))
  (let ((opt (?? (. (get listening_device text text2) present family) none)))
    (map (listening.devices_of text)
      (fn (ld)
        (let
          ((present ld.present)
           (b
             (and
               (and (and (and (contains xs present.id) (!= present.id text2)) present.can_play)
                 (some? opt))
               (== present.family opt)))
           (b2 (match present.follows (none () false) (some (text3) (contains xs text3))))
           (opt2
             (if (== present.id text2)
               (as (option Text) none)
               (if b
                 (some text2)
                 (if (or (== present.follows (some text2)) b2)
                   (as (option Text) none)
                   present.follows)))))
          (listening.put_present text
            ld.device
            (record (can_play present.can_play)
              (can_volume present.can_volume)
              (family present.family)
              (follows opt2)
              (id present.id)
              (kind present.kind)
              (muted present.muted)
              (name present.name)
              (user present.user)
              (volume present.volume))))))
    ()))

(live listening.release
  ()
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((session2
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock (listening.halted active.clock active.output ctx.now))
                 (from active.from)
                 (output (Output.Nowhere))
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(live listening.remove
  ((remove Remove))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (if (not (listening.in_queue session remove.index)) (refuse "the track is not in the queue"))
    (let
      ((session2
         (match session
           (Active (active)
             (let
               ((n (len active.queue))
                (b (== remove.index active.at))
                (b2 (>= (+ active.at 1) n))
                (b3 (match active.clock (Paused (at_ms) false) (Playing (at_ms since) true)))
                (clock (if (and b3 (not b2)) (Clock.Playing 0 ctx.now) (Clock.Paused 0))))
               (if (<= n 1)
                 (Session.Idle)
                 (Session.Active
                   (record
                     (at (if (or (< remove.index active.at) (and b b2)) (- active.at 1) active.at))
                     (clock (if b clock active.clock))
                     (from active.from)
                     (output active.output)
                     (queue (remove-at active.queue remove.index)))))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(live listening.report_group
  ((report_group ReportGroup))
  (if
    (not
      (match (get listening_device ctx.user ctx.session)
        (none () false)
        (some (ld) (some? ld.present.family))))
    (refuse "not here, or not a speaker that groups"))
  (listening.regrouped ctx.user ctx.session report_group.members))

(live listening.report_position
  ((report Report))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((session2
         (match session
           (Active (active)
             (let
               ((b
                  (match active.clock
                    (Paused (at_ms) false)
                    (Playing (at_ms since) (== since report.since))))
                (b2
                  (match active.output
                    (Away (id name) false)
                    (Device (id moving) (not moving))
                    (Nowhere () false))))
               (if (and b b2)
                 (Session.Active
                   (record (at active.at)
                     (clock (Clock.Playing report.at_ms ctx.now))
                     (from active.from)
                     (output active.output)
                     (queue active.queue)))
                 session)))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(live listening.report_volume
  ((report_volume ReportVolume))
  (if (not (listening.has_volume ctx.user ctx.session)) (refuse "not here, or no volume"))
  (let ((present (listening.present_of ctx.user ctx.session)))
    (listening.put_present ctx.user
      ctx.session
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted report_volume.muted)
        (name present.name)
        (user present.user)
        (volume report_volume.level)))))

(helper listening.returned
  ((output Output) (text Text))
  Output
  (match output
    (Away (id name) (if (== id text) (listening.here id) output))
    (Device (id moving) output)
    (Nowhere () output)))

(helper listening.scaled
  ((n Int) (n2 Int) (n3 Int))
  Int
  (if (== n2 0) n3 (clamp (/ (+ (* (* n n3) 2) n2) (* (max n2 1) 2)) 0 100)))

(live listening.scrub
  ((scrub Scrub))
  (delete listening_scrub ctx.user ctx.session)
  (match scrub.at_ms
    (none () ())
    (some (ms) (insert listening_scrub (record (user ctx.user) (device ctx.session) (at_ms ms))))))

(live listening.seek
  ((seek Seek))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (let
      ((session2
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock (listening.clock_at active.clock seek.ms ctx.now))
                 (from active.from)
                 (output active.output)
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(query listening.session_of
  ((text Text))
  Session
  (?? (. (get listening text) session) (Session.Idle)))

(live listening.set_group_mute
  ((group_mute GroupMute))
  (if (not (listening.group_has_volume ctx.user)) (refuse "nothing playing has a volume"))
  (listening.group_muted ctx.user (listening.leader ctx.user) group_mute.muted))

(live listening.set_group_volume
  ((group_volume GroupVolume))
  (if (not (listening.group_has_volume ctx.user)) (refuse "nothing playing has a volume"))
  (listening.group_at ctx.user (listening.leader ctx.user) group_volume.level))

(live listening.set_mute
  ((set_mute SetMute))
  (if (not (listening.has_volume ctx.user set_mute.device))
    (refuse "that device is not here, or has no volume"))
  (let ((present (listening.present_of ctx.user set_mute.device)))
    (listening.put_present ctx.user
      set_mute.device
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted set_mute.muted)
        (name present.name)
        (user present.user)
        (volume present.volume)))))

(live listening.set_volume
  ((set_volume SetVolume))
  (if (not (listening.has_volume ctx.user set_volume.device))
    (refuse "that device is not here, or has no volume"))
  (let ((present (listening.present_of ctx.user set_volume.device)))
    (listening.put_present ctx.user
      set_volume.device
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows present.follows)
        (id present.id)
        (kind present.kind)
        (muted false)
        (name present.name)
        (user present.user)
        (volume set_volume.level)))))

(live listening.skip
  ((skip Skip))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (let
      ((b
         (match session
           (Active (active) (or (< skip.by 0) (< (+ active.at 1) (len active.queue))))
           (Idle () false))))
      (if (not b) (refuse "nothing comes after this"))
      (if (not (or (listening.reachable session) (listening.can_play ctx.user ctx.session)))
        (refuse "nothing here can play it"))
      (let
        ((session2
           (match session
             (Active (active)
               (listening.moved_to active (max (+ active.at skip.by) 0) ctx.session ctx.now))
             (Idle () (Session.Idle)))))
        (listening.put_session ctx.user session2)))))

(helper listening.sounding
  ((session Session))
  Bool
  (match session
    (Active (active)
      (and (listening.is_here active.output)
        (match active.clock (Paused (at_ms) false) (Playing (at_ms since) true))))
    (Idle () false)))

(live listening.stalled
  ((at At))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((session2
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock (Clock.Paused at.at_ms))
                 (from active.from)
                 (output active.output)
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(helper listening.standing
  ((clock Clock) (output Output) (n Int))
  Int
  (let
    ((b (match output (Away (id name) false) (Device (id moving) moving) (Nowhere () false)))
     (n2 (match clock (Paused (at_ms) at_ms) (Playing (at_ms since) at_ms))))
    (if b n2 (listening.position clock n))))

(live listening.start
  ((start Start))
  (let ((session (listening.session_of ctx.user)))
    (if (not (< start.at (len start.queue))) (refuse "the track is not in the queue"))
    (if
      (not
        (or (or (listening.sounding session) (listening.reachable session))
          (listening.can_play ctx.user ctx.session)))
      (refuse "nothing here can play it"))
    (let
      ((b (or (listening.sounding session) (not (listening.can_play ctx.user ctx.session))))
       (output
         (match session
           (Active (active) (if b active.output (listening.here ctx.session)))
           (Idle () (listening.here ctx.session)))))
      (listening.put_session ctx.user
        (Session.Active
          (record (at start.at)
            (clock (Clock.Playing start.position ctx.now))
            (from start.from)
            (output output)
            (queue start.queue)))))))

(live listening.started
  ((at At))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((session2
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock (listening.clock_at active.clock at.at_ms ctx.now))
                 (from active.from)
                 (output (listening.here ctx.session))
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(live listening.stop () (listening.put_session ctx.user (Session.Idle)))

(live listening.transfer
  ((transfer Transfer))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is playing to move"))
    (if (not (listening.can_play ctx.user transfer.to))
      (refuse "that device is not here, or cannot play"))
    (listening.led_by ctx.user transfer.to)
    (let
      ((session2
         (match session
           (Active (active)
             (let ((b (== active.output (listening.here transfer.to))))
               (Session.Active
                 (record (at active.at)
                   (clock
                     (if b
                       active.clock
                       (listening.clock_at active.clock
                         (listening.standing active.clock active.output ctx.now)
                         ctx.now)))
                   (from active.from)
                   (output (if b active.output (Output.Device transfer.to true)))
                   (queue active.queue)))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user session2))))

(live listening.unjoin
  ((member Member))
  (if
    (not
      (match (get listening_device ctx.user member.device)
        (none () false)
        (some (ld) (some? ld.present.follows))))
    (refuse "that device is not in a group"))
  (let ((present (listening.present_of ctx.user member.device)))
    (listening.put_present ctx.user
      member.device
      (record (can_play present.can_play)
        (can_volume present.can_volume)
        (family present.family)
        (follows none)
        (id present.id)
        (kind present.kind)
        (muted present.muted)
        (name present.name)
        (user present.user)
        (volume present.volume)))))

(query listening.voiced
  ((text Text) (text2 Text))
  (list (row listening_device))
  (filter (listening.devices_of text)
    (fn (ld) (and (listening.in_group ld.present text2) ld.present.can_volume))))

(mutator playlists.add_all_to_playlist
  ((add_all_to_playlist AddAllToPlaylist))
  (let ((p (playlists.owned add_all_to_playlist.playlist_id)))
    (map (sort media (fn (m) m.pos))
      (fn (m)
        (if (none? (get playlist_item p.id m.id))
          (let
            ((x
               (first
                 (sort (filter playlist_item (fn (pi) (== pi.playlist_id p.id)))
                   (fn (pi) (desc pi.pos))))))
            (insert playlist_item
              (record (playlist_id p.id)
                (media_id m.id)
                (pos (+ (?? x.pos 0) 1))
                (added_ms ctx.now)
                (user_id ctx.user)))))))
    ()))

(mutator playlists.add_to_playlist
  ((add_to_playlist AddToPlaylist))
  (let ((p (playlists.owned add_to_playlist.playlist_id)))
    (if
      (and (some? (get media add_to_playlist.media_id))
        (none? (get playlist_item p.id add_to_playlist.media_id)))
      (let
        ((x
           (first
             (sort (filter playlist_item (fn (pi) (== pi.playlist_id p.id)))
               (fn (pi) (desc pi.pos))))))
        (insert playlist_item
          (record (playlist_id p.id)
            (media_id add_to_playlist.media_id)
            (pos (+ (?? x.pos 0) 1))
            (added_ms ctx.now)
            (user_id ctx.user)))))))

(mutator playlists.create_playlist
  ((create_playlist CreatePlaylist))
  (let ((playlist_id (new-id playlist)))
    (if (none? (get playlist playlist_id))
      (let
        ((x (first (sort playlist (fn (p) (desc p.pos)))))
         (xs
           (filter playlist
             (fn (p)
               (and (and (== p.user_id ctx.user) (>= p.name create_playlist.name))
                 (< p.name (concat (list create_playlist.name " )"))))))))
        (insert playlist
          (record (id playlist_id)
            (name (playlists.playlist_name (map xs (fn (p) p.name)) create_playlist.name))
            (pos (+ (?? x.pos 0) 1))
            (created_ms ctx.now)
            (user_id ctx.user)))))))

(helper playlists.free_number
  ((xs (list Text)) (text Text))
  Int
  (let ((xs2 (map xs (fn (text2) (len (filter xs (fn (text3) (<= text3 text2))))))))
    (??
      (first (sort (filter xs2 (fn (n) (not (contains xs (playlists.numbered text n))))) (fn (n) n)))
      (+ (len xs) 1))))

(helper playlists.numbered ((text Text) (n Int)) Text (concat (list text " (" (to-text n) ")")))

(query playlists.owned
  ((playlist_id (id playlist)))
  (row playlist)
  (match (get playlist playlist_id)
    (none () (refuse "not your playlist"))
    (some (p) (if (== p.user_id ctx.user) p (refuse "not your playlist")))))

(query playlists.playlist
  ((playlist_input PlaylistInput))
  (list LibraryEntry)
  (let ((p (playlists.owned playlist_input.playlist_id)))
    (map
      (sort
        (filter playlist_item
          (fn (pi) (and (== pi.playlist_id p.id) (some? (get media pi.media_id)))))
        (fn (pi) pi.pos))
      (fn (pi) (library.library_entry (unwrap (get media pi.media_id)) (some pi.pos))))))

(helper playlists.playlist_name
  ((xs (list Text)) (text Text))
  Text
  (if (contains xs text) (playlists.numbered text (playlists.free_number xs text)) text))

(query playlists.playlists
  ()
  (list (row playlist))
  (sort (filter playlist (fn (p) (== p.user_id ctx.user))) (fn (p) p.pos)))

(query playlists.playlists_of
  ((playlists_of PlaylistsOf))
  (list (row playlist))
  (sort
    (filter playlist
      (fn (p) (and (== p.user_id ctx.user) (some? (get playlist_item p.id playlists_of.media_id)))))
    (fn (p) p.pos)))

(mutator playlists.remove_from_playlist
  ((remove_from_playlist RemoveFromPlaylist))
  (let ((p (playlists.owned remove_from_playlist.playlist_id)))
    (delete playlist_item p.id remove_from_playlist.media_id)))
