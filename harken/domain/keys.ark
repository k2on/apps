; The library's keys: what a row of the library is keyed by, derived from
; what it is rather than minted, so that two peers naming "BWV 988" offline
; land on one row. Permanent: a key once written is a row's for good.

; The work an entry names: an entry without `work_title` names one anyway when
; it carries a catalogue number or a part, and then it is the album's.
(helper library.work_title
  ((work_title Text) (album Text) (catalogue Text) (part Text))
  Text
  (if (and (is-empty work_title) (or (not (is-empty catalogue)) (not (is-empty part))))
    album
    work_title))

; One name, reduced to something that can stand in a key: letters and digits
; lowercased, anything else a dash, none leading or trailing. Non-ASCII
; letters are kept.
(helper library.slug
  ((name Text))
  Text
  (let ((spaced (trim (concat (map (chars name) (fn (c) (if (is-alnum c) (lower c) " ")))))))
    (concat (map (chars spaced) (fn (c) (if (== c " ") "-" c))))))

; …and for a name with no letters at all, `x` and its hash: "!!!" is a band,
; and every such name in one key would be one band.
(helper library.key_part
  ((name Text))
  Text
  (let ((slug (library.slug name)))
    (if (is-empty slug) (concat (list "x" (to-text (fnv1a64 (trim name))))) slug)))

; The key of a work: its composer, and its catalogue number or its title.
(helper library.work_key
  ((composer Text) (catalogue Text) (title Text))
  Text
  (concat
    (list (library.key_part composer)
      "/"
      (library.key_part (if (is-empty catalogue) title catalogue)))))

; The key of the work a track is of, or none: a work needs a title and a
; composer.
(helper library.work_id
  ((composer Text) (catalogue Text) (title Text))
  (option Text)
  (if (or (is-empty title) (is-empty composer))
    none
    (some (library.work_key composer catalogue title))))

; The key of a movement: its work, and where it sits in it.
(helper library.movement_key
  ((work_id Text) (no Int))
  Text
  (concat (list work_id "#" (to-text no))))

; The key of a recording: what it is of, and by whom.
(helper library.recording_key
  ((of Text) (who Text))
  Text
  (concat (list of "@" (library.key_part who))))

; The key of the recording a track is part of; where there is no work, the
; release and the title make a pop track its own performance.
(helper library.recording_id
  ((work (option Text)) (album Text) (title Text) (artist Text) (performer Text))
  Text
  (library.recording_key
    (?? work (concat (list (library.key_part album) "/" (library.key_part title))))
    (if (is-empty performer) artist performer)))

; Who the one credit a track carries names: the performer, the artist of a
; track of no work, and nobody for a classical track naming no performer.
(helper library.credited_as
  ((work (option Text)) (artist Text) (performer Text))
  Text
  (if (is-empty performer) (if (some? work) "" artist) performer))

; The key of the movement a track is, or none when it is of no work.
(helper library.movement_id
  ((work (option Text)) (movement_no Int) (track Int))
  (option Text)
  (match work
    (none () none)
    (some (key) (some (library.movement_key key (if (== movement_no 0) track movement_no))))))
