; The library: what the scanner authors, and what every peer reads.
;
; Every playable thing (`media`), what only a song has (`song`), and the rows a
; track belongs to — `album`, `person`, `work`, `movement`, `recording`,
; `credit` — keyed by something derived from what they are rather than by a
; minted id, because two peers naming "BWV 988" offline must land on one row.
; The keys are the helpers below, and permanent.
;
; Every mutation here is the library's to make: `is_library` runs first and
; refuses an author without the `library` role. The queries are everybody's.
;
; `insert` refuses an existing key, so "unless a row has this key" and "this
; row, whatever was there" are each spelt with the lookup they are. `slug`
; does not collapse a run of separators, since nothing in the language sees
; two neighbouring characters.

; * What the queries share

; A media row as a list renders it, and where it sits on the playlist the
; list was read against, if it is on it.
(helper library.library_entry
  ((media (row media)) (playlist_pos (option Int)))
  LibraryEntry
  (record (added_ms media.added_ms)
    (creator media.creator)
    (duration_ms media.duration_ms)
    (file media.file)
    (id media.id)
    (kind media.kind)
    (playlist_pos playlist_pos)
    (pos media.pos)
    (title media.title)
    (user_id media.user_id)))

; The credits worth drawing: the real ones (`pos` from 1) where there are any,
; which displace the lumped string a track carried at `pos` 0.
(helper library.credited
  ((credits (list (row credit))))
  (list (row credit))
  (filter credits
    (fn (credit) (or (> credit.pos 0) (== (len (filter credits (fn (real) (> real.pos 0)))) 0)))))

; Names, as one line: "Hermann Scherchen, London Symphony Orchestra".
(helper library.joined
  ((names (list Text)))
  Text
  (?? (. (split-once (concat (map names (fn (name) (concat (list ", " name))))) ", ") 1) ""))

; Who played one recording: its credits in billing order, the composer left
; out.
(helper library.performers
  ((credits (list (row credit))) (recording_id Text))
  Text
  (library.joined
    (map
      (sort
        (library.credited
          (filter credits
            (fn (credit) (and (== credit.recording_id recording_id) (!= credit.role "composer")))))
        (fn (credit) (tuple credit.pos credit.person_name)))
      (fn (credit) credit.person_name))))

; A work, with how much of it the library holds.
(helper library.work_summary
  ((work (row work)) (recordings Int) (tracks Int))
  WorkSummary
  (record (art work.art)
    (catalogue work.catalogue)
    (composer work.composer)
    (form work.form)
    (id work.id)
    (period work.period)
    (recordings recordings)
    (title work.title)
    (tracks tracks)))

; The sum of some counts.
(helper library.total ((counts (list Int))) Int (sum counts))

; How many songs are movements of a work.
(query library.work_tracks
  ((work_id Text))
  Int
  (library.total
    (map (filter movement (fn (movement) (== movement.work_id work_id)))
      (fn (movement) (len (filter song (fn (song) (== song.movement_id (some movement.id)))))))))

; Works, each with how many recordings of it there are and how many tracks are
; movements of it.
(query library.summaries
  ((works (list (row work))))
  (list WorkSummary)
  (map works
    (fn (work)
      (library.work_summary work
        (len (filter recording (fn (recording) (== recording.work_id (some work.id)))))
        (library.work_tracks work.id)))))

; The library's role, or a refusal: what every library mutation runs first.
(helper library.is_library
  ()
  (tuple)
  (if (not (has-role "library")) (refuse "only the library writes the library")))

; A playlist's entry for a media row, if it is on it.
(query library.playlist_pos
  ((playlist_id (id playlist)) (media_id (id media)))
  (option Int)
  (?. (get playlist_item playlist_id media_id) pos))

; The movement a song is, if it is one.
(query library.movement_of
  ((song (row song)))
  (option (row movement))
  (match song.movement_id (none () none) (some (id) (get movement id))))

; Whether a text holds the needle, both folded by the pinned `lower`.
(helper library.has
  ((text Text) (needle Text))
  Bool
  (or (is-empty needle) (some? (split-once (lower text) (lower needle)))))

; * The mutations

; Put a song in the library, and everything it belongs to as rows. An upsert
; by `file`: a file the library has is the song it is, said again, so the
; media row keeps its id, place, when and by whom it was added; the same file
; with nothing new writes no row. What the song was part of and no longer is —
; a recording, a movement, a work — goes when nothing else is part of it.
(mutator library.add_song
  ((input AddSong))
  (library.is_library)
  (let
    ((was
       (match (first (filter media (fn (media) (== media.file input.file))))
         (none () (as (option (row media)) none))
         (some (media)
           (if (not (is-empty media.file)) (some media) (as (option (row media)) none)))))
     (id (?? was.id (new-id media)))
     (newest (first (sort media (fn (media) (desc media.pos)))))
     (row
       (as (row media)
         (record (id id)
           (kind (?? was.kind "song"))
           (title input.title)
           (creator input.artist)
           (duration_ms input.duration_ms)
           (file input.file)
           (pos (?? was.pos (+ (?? newest.pos 0) 1)))
           (added_ms (?? was.added_ms ctx.now))
           (user_id (?? was.user_id ctx.user))))))
    (if (some? (get media id)) (update media id (fn (old) row)) (insert media row))
    (if (not (is-empty input.album))
      (let ((album (get album input.album)))
        (if
          (match album
            (none () true)
            (some (album) (and (not (is-empty input.album_art)) (!= album.art input.album_art))))
          (let
            ((row
               (as (row album)
                 (record (name input.album)
                   (label (?? album.label ""))
                   (released (?? album.released 0))
                   (art input.album_art)
                   (added_ms ctx.now)
                   (user_id ctx.user)))))
            (if (some? album) (update album input.album (fn (old) row)) (insert album row))))))
    (if (not (is-empty input.artist))
      (let ((person (get person input.artist)))
        (if
          (match person
            (none () true)
            (some (person)
              (and (not (is-empty input.artist_art)) (!= person.art input.artist_art))))
          (let
            ((row
               (as (row person)
                 (record (name input.artist)
                   (sort_name (?? person.sort_name ""))
                   (born (?? person.born 0))
                   (died (?? person.died 0))
                   (art input.artist_art)
                   (added_ms (?? person.added_ms ctx.now))
                   (user_id (?? person.user_id ctx.user))))))
            (if (some? person) (update person input.artist (fn (old) row)) (insert person row))))))
    (let
      ((title (library.work_title input.work_title input.album input.catalogue input.part))
       (work_of (library.work_id input.artist input.catalogue title)))
      (if (some? work_of)
        (let
          ((key (library.work_key input.artist input.catalogue title))
           (no (if (== input.movement_no 0) input.track input.movement_no))
           (movement_key (library.movement_key key no))
           (work (get work key))
           (row
             (as (row work)
               (record (id key)
                 (composer input.artist)
                 (title title)
                 (catalogue input.catalogue)
                 (opus (?? work.opus ""))
                 (key_sig (?? work.key_sig ""))
                 (form (?? work.form ""))
                 (period (?? work.period ""))
                 (composed (?? work.composed 0))
                 (art (?? work.art ""))
                 (added_ms (?? work.added_ms ctx.now))
                 (user_id (?? work.user_id ctx.user))))))
          (if (some? work) (update work key (fn (old) row)) (insert work row))
          (let
            ((movement (get movement movement_key))
             (row
               (as (row movement)
                 (record (id movement_key)
                   (work_id key)
                   (no no)
                   (title input.title)
                   (part input.part)
                   (added_ms (?? movement.added_ms ctx.now))
                   (user_id (?? movement.user_id ctx.user))))))
            (if (some? movement)
              (update movement movement_key (fn (old) row))
              (insert movement row)))))
      (let
        ((recording_id
           (library.recording_id work_of input.album input.title input.artist input.performer))
         (credited (library.credited_as work_of input.artist input.performer)))
        (if (none? (get recording recording_id))
          (insert recording
            (record (id recording_id)
              (work_id work_of)
              (recorded 0)
              (venue "")
              (label "")
              (licence "")
              (art "")
              (added_ms ctx.now)
              (user_id ctx.user))))
        (if (not (is-empty credited))
          (let ()
            (if (none? (get person credited))
              (insert person
                (record (name credited)
                  (sort_name "")
                  (born 0)
                  (died 0)
                  (art "")
                  (added_ms ctx.now)
                  (user_id ctx.user))))
            (let ((role (if (some? work_of) "performer" "artist")))
              (if (none? (get credit recording_id credited role))
                (insert credit
                  (record (recording_id recording_id)
                    (person_name credited)
                    (role role)
                    (instrument "")
                    (pos 0)
                    (added_ms ctx.now)
                    (user_id ctx.user)))))))
        (let
          ((movement_id (library.movement_id work_of input.movement_no input.track))
           (previous (get song id))
           (row
             (as (row song)
               (record (media_id id)
                 (album_name (if (is-empty input.album) none (some input.album)))
                 (disc (if (> input.disc 0) (min input.disc 99) 1))
                 (track (clamp input.track 0 999))
                 (recording_id recording_id)
                 (movement_id movement_id)
                 (bpm (if (and (>= input.bpm 20) (<= input.bpm 300)) input.bpm 0))))))
          (if (some? previous) (update song id (fn (old) row)) (insert song row))
          (let
            ((left
               (match (?. previous recording_id)
                 (none () (as (option Text) none))
                 (some (was) (if (!= was recording_id) (some was) (as (option Text) none))))))
            (if
              (and (some? left)
                (== (len (filter song (fn (song) (== song.recording_id (unwrap left))))) 0))
              (let ()
                (let ()
                  (map (filter credit (fn (credit) (== credit.recording_id (unwrap left))))
                    (fn (credit)
                      (delete credit credit.recording_id credit.person_name credit.role)))
                  ())
                (delete recording (unwrap left))))
            (let
              ((moved
                 (match (?? previous.movement_id none)
                   (none () (as (option Text) none))
                   (some (was)
                     (if (!= (some was) movement_id) (some was) (as (option Text) none))))))
              (if
                (and (some? moved)
                  (== (len (filter song (fn (song) (== song.movement_id moved)))) 0))
                (let ((of (?? (. (get movement (unwrap moved)) work_id) "")))
                  (delete movement (unwrap moved))
                  (if
                    (and (== (len (filter movement (fn (movement) (== movement.work_id of)))) 0)
                      (== (len (filter recording (fn (recording) (== recording.work_id (some of)))))
                        0))
                    (delete work of)))))))))))

; Say more about a work. A work exists because a song named it, so an unknown
; one is refused; every field is fill-if-given.
(mutator library.describe_work
  ((input DescribeWork))
  (library.is_library)
  (if (none? (get work input.id))
    (refuse (concat (list "no work " input.id "; a work exists because a song named it"))))
  (update work
    input.id
    (fn (work)
      (record (id work.id)
        (composer work.composer)
        (title work.title)
        (catalogue work.catalogue)
        (opus (if (is-empty input.opus) work.opus input.opus))
        (key_sig (if (is-empty input.key_sig) work.key_sig input.key_sig))
        (form (if (is-empty input.form) work.form input.form))
        (period (if (is-empty input.period) work.period input.period))
        (composed (if (== input.composed 0) work.composed input.composed))
        (art (if (is-empty input.art) work.art input.art))
        (added_ms ctx.now)
        (user_id work.user_id)))))

; Say more about a performance; refuses an unknown one.
(mutator library.describe_recording
  ((input DescribeRecording))
  (library.is_library)
  (if (none? (get recording input.id))
    (refuse (concat (list "no recording " input.id "; one exists because a song is part of it"))))
  (update recording
    input.id
    (fn (recording)
      (record (id recording.id)
        (work_id recording.work_id)
        (recorded (if (== input.recorded 0) recording.recorded input.recorded))
        (venue (if (is-empty input.venue) recording.venue input.venue))
        (label (if (is-empty input.label) recording.label input.label))
        (licence (if (is-empty input.licence) recording.licence input.licence))
        (art (if (is-empty input.art) recording.art input.art))
        (added_ms ctx.now)
        (user_id recording.user_id)))))

; Say more about somebody, making the row when it is not there.
(mutator library.describe_person
  ((input DescribePerson))
  (library.is_library)
  (let
    ((person (get person input.name))
     (row
       (as (row person)
         (record (name input.name)
           (sort_name (if (is-empty input.sort_name) (?? person.sort_name "") input.sort_name))
           (born (if (== input.born 0) (?? person.born 0) input.born))
           (died (if (== input.died 0) (?? person.died 0) input.died))
           (art (if (is-empty input.art) (?? person.art "") input.art))
           (added_ms (?? person.added_ms ctx.now))
           (user_id (?? person.user_id ctx.user))))))
    (if (some? person) (update person input.name (fn (old) row)) (insert person row))))

; Credit somebody on a recording, properly: keyed by the three, so a person
; may hold two roles and a second entry is a correction. A real credit is at
; least 1; 0 is the lumped fallback's.
(mutator library.credit_recording
  ((input CreditRecording))
  (library.is_library)
  (if (none? (get recording input.recording_id))
    (refuse (concat (list "no recording " input.recording_id " to credit anybody on"))))
  (if (none? (get person input.person_name))
    (insert person
      (record (name input.person_name)
        (sort_name "")
        (born 0)
        (died 0)
        (art "")
        (added_ms ctx.now)
        (user_id ctx.user))))
  (let
    ((role (if (is-empty input.role) "artist" input.role))
     (credit (get credit input.recording_id input.person_name role))
     (row
       (as (row credit)
         (record (recording_id input.recording_id)
           (person_name input.person_name)
           (role role)
           (instrument (if (is-empty input.instrument) (?? credit.instrument "") input.instrument))
           (pos (if (== input.pos 0) (max (?? credit.pos 0) 1) (max input.pos 1)))
           (added_ms ctx.now)
           (user_id ctx.user)))))
    (if (some? credit)
      (update credit input.recording_id input.person_name role (fn (old) row))
      (insert credit row))))

; Take something out of the library, and off every playlist holding it.
(mutator library.remove_media
  ((input RemoveMedia))
  (library.is_library)
  (let ()
    (map (filter playlist_item (fn (item) (== item.media_id input.id)))
      (fn (item) (delete playlist_item item.playlist_id item.media_id)))
    ())
  (delete song input.id)
  (delete media input.id))
