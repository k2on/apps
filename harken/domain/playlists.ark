; The playlists: what a person does on any device, offline or not.
;
; A playlist is a list somebody made; "Favorites" is one of these and nothing
; special. It is ordered, so adding reads the last `pos` and goes one past it,
; which is what makes the rebase visible: add while offline and it lands after
; whatever arrived while you were away. Anybody may make one, nobody (a peer
; before anyone signed in, user "") included; `owned` lets nobody else at it.

; The playlist a function is about, when it is the caller's; refused otherwise.
(query playlists.owned
  ((playlist_id (id playlist)))
  (row playlist)
  (match (get playlist playlist_id)
    (none () (refuse "not your playlist"))
    (some (playlist) (if (== playlist.user_id ctx.user) playlist (refuse "not your playlist")))))

; A name with a number after it: "Favorites (1)".
(helper playlists.numbered ((name Text) (n Int)) Text (concat (list name " (" (to-text n) ")")))

; The smallest n from 1 whose "name (n)" is none of these names. The names are
; one person's, so distinct: each one's rank among them is one of 1..len, so the
; answer is len + 1 or among the ranks — the least rank free, found by sorting.
(helper playlists.free_number
  ((names (list Text)) (name Text))
  Int
  (let ((ranks (map names (fn (it) (len (filter names (fn (other) (<= other it))))))))
    (??
      (first
        (sort (filter ranks (fn (rank) (not (contains names (playlists.numbered name rank)))))
          (fn (rank) rank)))
      (+ (len names) 1))))

; What a new playlist is called among a person's other playlists: the name
; asked for, or when they have one of that name, the first "name (n)" they do
; not have.
(helper playlists.playlist_name
  ((names (list Text)) (name Text))
  Text
  (if (contains names name) (playlists.numbered name (playlists.free_number names name)) name))

; Make a playlist, after every other. A name the person already has is
; numbered, decided from the rows at apply time so every peer replaying reaches
; the same name in log order; of theirs, only the names from `name` up to
; `name )` are read — the name and its numbered siblings. The same entry twice
; is one playlist: its id is the key.
(mutator playlists.create_playlist
  ((input CreatePlaylist))
  (let ((id (new-id playlist)))
    (if (none? (get playlist id))
      (let
        ((last (first (sort playlist (fn (playlist) (desc playlist.pos)))))
         (siblings
           (filter playlist
             (fn (playlist)
               (and (and (== playlist.user_id ctx.user) (>= playlist.name input.name))
                 (< playlist.name (concat (list input.name " )"))))))))
        (insert playlist
          (record (id id)
            (name (playlists.playlist_name (map siblings (fn (sibling) sibling.name)) input.name))
            (pos (+ (?? last.pos 0) 1))
            (created_ms ctx.now)
            (user_id ctx.user)))))))

; Put something on a playlist, at the end of it. A playlist holds an item
; once, so adding one already there keeps its place; something no longer in
; the library is a no-op.
(mutator playlists.add_to_playlist
  ((input AddToPlaylist))
  (let ((playlist (playlists.owned input.playlist_id)))
    (if
      (and (some? (get media input.media_id))
        (none? (get playlist_item playlist.id input.media_id)))
      (let
        ((last
           (first
             (sort (filter playlist_item (fn (item) (== item.playlist_id playlist.id)))
               (fn (item) (desc item.pos))))))
        (insert playlist_item
          (record (playlist_id playlist.id)
            (media_id input.media_id)
            (pos (+ (?? last.pos 0) 1))
            (added_ms ctx.now)
            (user_id ctx.user)))))))

; Put everything in the library on a playlist, in library order. One entry,
; an intent: replayed, it covers whatever the library held by then.
(mutator playlists.add_all_to_playlist
  ((input AddAllToPlaylist))
  (let ((playlist (playlists.owned input.playlist_id)))
    (map (sort media (fn (track) track.pos))
      (fn (track)
        (if (none? (get playlist_item playlist.id track.id))
          (let
            ((last
               (first
                 (sort (filter playlist_item (fn (item) (== item.playlist_id playlist.id)))
                   (fn (item) (desc item.pos))))))
            (insert playlist_item
              (record (playlist_id playlist.id)
                (media_id track.id)
                (pos (+ (?? last.pos 0) 1))
                (added_ms ctx.now)
                (user_id ctx.user)))))))
    ()))

; Take something off a playlist. The item stays in the library.
(mutator playlists.remove_from_playlist
  ((input RemoveFromPlaylist))
  (let ((playlist (playlists.owned input.playlist_id)))
    (delete playlist_item playlist.id input.media_id)))

; The caller's playlists, in the order they were made.
(query playlists.playlists
  ()
  (list (row playlist))
  (sort (filter playlist (fn (playlist) (== playlist.user_id ctx.user)))
    (fn (playlist) playlist.pos)))

; Which of the caller's playlists a track is on: what makes a playlist sheet
; a toggle.
(query playlists.playlists_of
  ((input PlaylistsOf))
  (list (row playlist))
  (sort
    (filter playlist
      (fn (playlist)
        (and (== playlist.user_id ctx.user)
          (some? (get playlist_item playlist.id input.media_id)))))
    (fn (playlist) playlist.pos)))

; One playlist's contents, in playlist order, as the library's own rows; an
; entry whose media has gone is dropped.
(query playlists.playlist
  ((input PlaylistInput))
  (list LibraryEntry)
  (let ((playlist (playlists.owned input.playlist_id)))
    (map
      (sort
        (filter playlist_item
          (fn (item) (and (== item.playlist_id playlist.id) (some? (get media item.media_id)))))
        (fn (item) item.pos))
      (fn (item) (library.library_entry (unwrap (get media item.media_id)) (some item.pos))))))
