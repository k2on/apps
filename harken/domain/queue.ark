; The queue, edited from any device while it plays.

; Tracks put after the one playing ("Play next") or at the end ("Add to
; queue"); into nothing queued it is `start` of them from the first.
(live listening.enqueue
  ((input Enqueue))
  (let ((session (listening.session_of ctx.user)))
    (if (not (or (listening.is_active session) (listening.can_play ctx.user ctx.session)))
      (refuse "nothing here can play it"))
    (let
      ((next
         (match session
           (Active (active)
             (let ((end (len active.queue)) (at (min (if input.next (+ active.at 1) end) end)))
               (Session.Active
                 (record (at active.at)
                   (clock active.clock)
                   (from active.from)
                   (output active.output)
                   (queue
                     (concat (concat (slice active.queue 0 at) input.tracks)
                       (slice active.queue at end)))))))
           (Idle ()
             (Session.Active
               (record (at 0)
                 (clock (Clock.Playing 0 ctx.now))
                 (from "")
                 (output (listening.here ctx.session))
                 (queue input.tracks)))))))
      (listening.put_session ctx.user next))))

; A track out of the queue. The one playing taken out is the next one playing,
; from its start — or with nothing after it, the one before, paused at its
; start; the last track of all taken out is nothing queued.
(live listening.remove
  ((input Remove))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (if (not (listening.in_queue session input.index)) (refuse "the track is not in the queue"))
    (let
      ((next
         (match session
           (Active (active)
             (let
               ((end (len active.queue))
                (playing_one (== input.index active.at))
                (last (>= (+ active.at 1) end))
                (playing (match active.clock (Paused (at_ms) false) (Playing (at_ms since) true)))
                (clock (if (and playing (not last)) (Clock.Playing 0 ctx.now) (Clock.Paused 0))))
               (if (<= end 1)
                 (Session.Idle)
                 (Session.Active
                   (record
                     (at
                       (if (or (< input.index active.at) (and playing_one last))
                         (- active.at 1)
                         active.at))
                     (clock (if playing_one clock active.clock))
                     (from active.from)
                     (output active.output)
                     (queue (remove-at active.queue input.index)))))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))

; A track of the queue somewhere else in it; the one playing plays on.
(live listening.move
  ((input Move))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (if (not (and (listening.in_queue session input.from) (listening.in_queue session input.to)))
      (refuse "the track is not in the queue"))
    (let
      ((next
         (match session
           (Active (active)
             (Session.Active
               (record (at (listening.moved_place active.at input.from input.to))
                 (clock active.clock)
                 (from active.from)
                 (output active.output)
                 (queue (move-at active.queue input.from input.to)))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))

; Everything after the track playing, gone; it plays on.
(live listening.clear_upcoming
  ()
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_active session)) (refuse "nothing is queued"))
    (let
      ((next
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock active.clock)
                 (from active.from)
                 (output active.output)
                 (queue (slice active.queue 0 (min (+ active.at 1) (len active.queue)))))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))

; * What the output says

; The output has the hand-off, at this point in the track.
(live listening.started
  ((input At))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((next
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock (listening.clock_at active.clock input.at_ms ctx.now))
                 (from active.from)
                 (output (listening.here ctx.session))
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))

; The output's track ended: the next one, or paused at the start of the last
; when there is none. About a track no longer playing, nothing.
(live listening.advance
  ((input Advance))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((next
         (match session
           (Active (active)
             (if (!= active.at input.from_track)
               session
               (if (< (+ active.at 1) (len active.queue))
                 (Session.Active
                   (record (at (+ active.at 1))
                     (clock (Clock.Playing 0 ctx.now))
                     (from active.from)
                     (output active.output)
                     (queue active.queue)))
                 (Session.Active
                   (record (at active.at)
                     (clock (Clock.Paused 0))
                     (from active.from)
                     (output active.output)
                     (queue active.queue))))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))

; The output stopped making a sound by itself, here.
(live listening.stalled
  ((input At))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((next
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock (Clock.Paused input.at_ms))
                 (from active.from)
                 (output active.output)
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))

; The output, playing, says where it is; the clock is re-anchored there. About
; a clock that has moved since, or a hand-off in flight, nothing.
(live listening.report_position
  ((input Report))
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((next
         (match session
           (Active (active)
             (let
               ((same_clock
                  (match active.clock
                    (Paused (at_ms) false)
                    (Playing (at_ms since) (== since input.since))))
                (settled
                  (match active.output
                    (Away (id name) false)
                    (Device (id moving) (not moving))
                    (Nowhere () false))))
               (if (and same_clock settled)
                 (Session.Active
                   (record (at active.at)
                     (clock (Clock.Playing input.at_ms ctx.now))
                     (from active.from)
                     (output active.output)
                     (queue active.queue)))
                 session)))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))

; The output lets the sound go: the queue stays, paused, and nothing is the
; output.
(live listening.release
  ()
  (let ((session (listening.session_of ctx.user)))
    (if (not (listening.is_output session ctx.session)) (refuse "not the output"))
    (let
      ((next
         (match session
           (Active (active)
             (Session.Active
               (record (at active.at)
                 (clock (listening.halted active.clock active.output ctx.now))
                 (from active.from)
                 (output (Output.Nowhere))
                 (queue active.queue))))
           (Idle () (Session.Idle)))))
      (listening.put_session ctx.user next))))
