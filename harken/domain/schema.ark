; The tables. The indexes are there for the mutations' reads.

; The library: every playable thing, what only a song has, and the rows a track
; belongs to, each keyed by what it is (`keys.ark`).
(schema
  (table media
    (id (id media) key)
    (kind Text)
    (title Text)
    (creator Text)
    (duration_ms Int)
    (file Text)
    (pos Int)
    (added_ms Int)
    (user_id Text)
    (index file)
    (index pos))
  (table album (name Text key) (label Text) (released Int) (art Text) (added_ms Int) (user_id Text))
  (table person
    (name Text key)
    (sort_name Text)
    (born Int)
    (died Int)
    (art Text)
    (added_ms Int)
    (user_id Text))
  (table work
    (id Text key)
    (composer Text (refs person))
    (title Text)
    (catalogue Text)
    (opus Text)
    (key_sig Text)
    (form Text)
    (period Text)
    (composed Int)
    (art Text)
    (added_ms Int)
    (user_id Text))
  (table movement
    (id Text key)
    (work_id Text (refs work))
    (no Int)
    (title Text)
    (part Text)
    (added_ms Int)
    (user_id Text))
  (table recording
    (id Text key)
    (work_id (option Text) (refs work))
    (recorded Int)
    (venue Text)
    (label Text)
    (licence Text)
    (art Text)
    (added_ms Int)
    (user_id Text))
  (table credit
    (recording_id Text key (refs recording))
    (person_name Text key (refs person))
    (role Text key)
    (instrument Text)
    (pos Int)
    (added_ms Int)
    (user_id Text))
  (table song
    (media_id (id media) key (refs media))
    (album_name (option Text) (refs album))
    (disc Int)
    (track Int)
    (recording_id Text (refs recording))
    (movement_id (option Text) (refs movement))
    (bpm Int)))

; The playlists: each one person's, its name unique among theirs.
(schema
  (table playlist
    (id (id playlist) key)
    (name Text)
    (pos Int)
    (created_ms Int)
    (user_id Text)
    (index unique user_id name)
    (index pos)
    (index user_id pos))
  (table playlist_item
    (playlist_id (id playlist) key (refs playlist))
    (media_id (id media) key (refs media))
    (pos Int)
    (added_ms Int)
    (user_id Text)
    (index playlist_id pos)))

; A track that was played: one row per play, carrying the track as it was heard
; and its media id as text, which references nothing, on purpose: a play is a
; fact about what was heard, not a hold on the library.
(schema
  (table play
    (id (id play) key)
    (user_id Text)
    (track Text)
    (title Text)
    (creator Text)
    (album Text)
    (duration_ms Int)
    (file Text)
    (played_ms Int)
    (from Text)
    (index user_id played_ms)))

; The listening session, volatile: one row per account while it has a session
; (no row is `Idle`), one per device standing in it — both ordered — and one per
; device dragging a scrubber, which only its own device writes and nothing
; ordered reads.
(schema (table listening volatile (user Text key) (session Session))
  (table listening_device volatile (user Text key) (device Text key) (present Present))
  (table listening_scrub volatile (user Text key) (device Text key) (at_ms Int)))

