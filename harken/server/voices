#!/usr/bin/env python3
"""Who says each line of an episode's captions: `voices <audio> <in.vtt> <out.vtt>`.

The captions again, each line's `<v Speaker N>` the voice that says it —
`Speaker 1` the first to speak — and a `NOTE voice Speaker N` per voice,
what it sounds like: its print, the direction of its lines in a speaker
model's space, as whole numbers. The server reads both (src/captions.rs),
and a voice named in one episode is known by its print in the next
(domain/src/shows.rs).

Each line is heard a few seconds at a time by the speaker model
(HARKEN_VOICES_MODEL: 3D-Speaker's ERes2Net, trained on VoxCeleb, through
sherpa-onnx), and the pieces are put together by how alike they sound:
average linkage over their cosines, apart past `APART`. A voice heard for
less than `LEAST` seconds is the likest of the others — a laugh, a word
said over somebody — and a line is the voice most of it is.

On two-person podcasts it names 98.8% of lines right; one person's prints
across episodes are 0.85 and over alike, two people's under 0.6.
"""

import os
import re
import subprocess
import sys

import numpy as np
import sherpa_onnx
from scipy.cluster.hierarchy import fcluster, linkage

RATE = 16_000
# The longest piece of a line heard at once, and the shortest heard at all.
PIECE, SHORTEST = 4.0, 0.4
# How far apart, as a cosine distance, two pieces are two voices.
APART = 0.7
# The fewest seconds a voice is heard for to be one.
LEAST = 30.0
# A print's length, as the whole numbers it is written in.
SCALE = 10_000

TIMES = re.compile(r"^\s*((?:\d+:)?\d+:\d+\.\d+)\s+-->\s+((?:\d+:)?\d+:\d+\.\d+)")


def seconds(t):
    whole = 0.0
    for part in t.split(":"):
        whole = whole * 60 + float(part)
    return whole


def cues(text):
    """Each cue's block: its times, the lines over them and the lines said."""
    out = []
    for block in text.replace("\r\n", "\n").split("\n\n"):
        lines = block.strip("\n").split("\n")
        at = next((i for i, l in enumerate(lines) if TIMES.match(l)), None)
        if at is None:
            continue
        start, end = (seconds(t) for t in TIMES.match(lines[at]).groups())
        said = [re.sub(r"^<v[^>]*>|</v>", "", l) for l in lines[at + 1 :]]
        out.append((start, end, lines[: at + 1], said))
    return out


def audio(path):
    raw = subprocess.run(
        ["ffmpeg", "-nostdin", "-loglevel", "error", "-i", path, "-ar", str(RATE), "-ac", "1", "-f", "f32le", "-"],
        stdout=subprocess.PIPE,
        check=True,
    ).stdout
    return np.frombuffer(raw, dtype=np.float32)


def unit(m):
    return m / np.maximum(np.linalg.norm(m, axis=-1, keepdims=True), 1e-9)


def main(audio_path, captions_in, captions_out):
    said = cues(open(captions_in, encoding="utf-8").read())
    x = audio(audio_path)
    model = sherpa_onnx.SpeakerEmbeddingExtractor(
        sherpa_onnx.SpeakerEmbeddingExtractorConfig(
            model=os.environ["HARKEN_VOICES_MODEL"],
            num_threads=int(os.environ.get("HARKEN_VOICES_THREADS", "2")),
        )
    )

    # Each line a piece at a time: (line, seconds, print).
    pieces = []
    for i, (start, end, _, _) in enumerate(said):
        long = end - start
        if long < SHORTEST:
            continue
        n = int(np.ceil(long / PIECE))
        for k in range(n):
            a, b = start + long * k / n, start + long * (k + 1) / n
            samples = x[int(a * RATE) : int(b * RATE)]
            if len(samples) < SHORTEST * RATE:
                continue
            s = model.create_stream()
            s.accept_waveform(RATE, samples)
            s.input_finished()
            pieces.append((i, b - a, np.array(model.compute(s), dtype=np.float64)))

    voice_of = {}
    prints = {}
    if pieces:
        e = unit(np.array([p for _, _, p in pieces]))
        long = np.array([d for _, d, _ in pieces])
        group = fcluster(linkage(e, "average", "cosine"), APART, "distance") if len(e) > 1 else np.array([1])
        # A voice heard too little is the likest of those heard enough.
        heard = {g: long[group == g].sum() for g in set(group)}
        enough = [g for g, h in heard.items() if h >= LEAST] or [max(heard, key=heard.get)]
        centres = unit(np.array([e[group == g].mean(0) for g in enough]))
        group = np.array([g if g in enough else enough[int((centres @ e[j]).argmax())] for j, g in enumerate(group)])
        # Each line the voice most of it is.
        by_line = {}
        for (i, d, _), g in zip(pieces, group):
            by_line.setdefault(i, {}).setdefault(g, 0.0)
            by_line[i][g] += d
        line_voice = {i: max(v, key=v.get) for i, v in by_line.items()}
        # A line too short to hear is the voice of the line nearest it.
        heard_lines = sorted(line_voice)
        for i in range(len(said)):
            if i not in line_voice:
                near = min(heard_lines, key=lambda j: abs(j - i))
                line_voice[i] = line_voice[near]
        # Named in the order they first speak.
        order = list(dict.fromkeys(line_voice[i] for i in range(len(said))))
        names = {g: f"Speaker {n + 1}" for n, g in enumerate(order)}
        voice_of = {i: names[g] for i, g in line_voice.items()}
        for g in order:
            prints[names[g]] = np.rint(unit(e[group == g].mean(0)) * SCALE).astype(int)

    out = ["WEBVTT"]
    for name, p in prints.items():
        out.append(f"NOTE voice {name}\n" + " ".join(str(n) for n in p))
    for i, (_, _, head, lines) in enumerate(said):
        if i in voice_of and lines:
            lines = [f"<v {voice_of[i]}>{lines[0]}"] + lines[1:]
        out.append("\n".join(head + lines))
    with open(captions_out, "w", encoding="utf-8") as f:
        f.write("\n\n".join(out) + "\n")


if __name__ == "__main__":
    if len(sys.argv) != 4:
        sys.exit("usage: voices <audio> <in.vtt> <out.vtt>")
    main(*sys.argv[1:])
