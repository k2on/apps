schema {
  table playlist {
    id: Id<playlist> key
    name: Text
    user_id: Text
    index unique (user_id, name)
  }
  table item {
    playlist_id: Id<playlist> key refs playlist
    track_id: Text key
    pos: Int
    index unique (playlist_id, pos)
  }
}

type Name = Text where trim, non_empty "a playlist needs a name"
type TrackId = Text where len 1..

mutator demo.add_to_playlist(playlist_id: Id<playlist>, track_id: TrackId) = if playlist.get(playlist_id).is_some() {
  if item.get(playlist_id, track_id).is_some() {
    ()
  } else {
    let x = item.filter(i => i.playlist_id == playlist_id).sort(i => desc i.pos).take(1).first()
    item.insert({ playlist_id: playlist_id, track_id: track_id, pos: (match x {
      none => 0
      some(i) => i.pos
    }) + 1 })
  }
} else {
  refuse "playlist_id: no such playlist"
}

mutator demo.create_playlist(name: Name) = if playlist.filter(p => p.user_id == ctx.user and p.name == name).len() == 0 {
  playlist.insert({ id: ctx.new_id(playlist), name: name, user_id: ctx.user })
}

mutator demo.remove_from_playlist(playlist_id: Id<playlist>, text: Text) = item.delete(playlist_id, text)

mutator demo.rename_playlist(playlist_id: Id<playlist>, name: Name) = if playlist.get(playlist_id).is_some() {
  playlist.update(playlist_id, p => { name: name, ..p })
} else {
  refuse "no such playlist"
}
