cabal-version:      3.0
name:               ark-spec
version:            0.1.0
synopsis:           The ArkDB specification, as a program
description:
  The executable specification of ArkDB. Every module here is normative: a
  runtime in any language is conformant when it agrees with this program on
  the vectors it emits. Prose that would otherwise be a specification
  document is in the comments beside the definitions it explains, and
  README.md is the index. Only GHC boot libraries are used, so that the spec
  depends on nothing but a compiler.
license:            NONE
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing
  build-depends:    base >=4.16 && <5, array, bytestring, containers, text, mtl

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Ark.Value
    Ark.Canon
    Ark.Sha256
    Ark.Hash
    Ark.Schema
    Ark.IR
    Ark.Std
    Ark.Encode
    Ark.Std.Unicode
    Ark.Store
    Ark.Eval
    Ark.Verify
    Ark.Log
    Ark.Peer

executable ark-vectors
  import:           shared
  hs-source-dirs:   app
  main-is:          Vectors.hs
  build-depends:    ark-spec, directory
