  "ark": "(schema\u000a  (table playlist (id (id playlist) key) (name Text) (user_id Text) (index unique user_id name))\u000a  (table item\u000a    (playlist_id (id playlist) key (refs playlist))\u000a    (track_id Text key)\u000a    (pos Int)\u000a    (index unique playlist_id pos)))\u000a\u000a(type Name (where Text (trim) (non-empty) \"a playlist needs a name\"))\u000a\u000a(type TrackId (where Text (len 1 ..)))\u000a\u000a(mutator demo.add_to_playlist\u000a  ((playlist_id (id playlist)) (track_id TrackId))\u000a  (if (some? (get playlist playlist_id))\u000a    (if (some? (get item playlist_id track_id))\u000a      ()\u000a      (let\u000a        ((x\u000a           (first\u000a             (take\u000a               (sort (filter item (fn (i) (== i.playlist_id playlist_id))) (fn (i) (desc i.pos)))\u000a               1))))\u000a        (insert item\u000a          (record (playlist_id playlist_id) (track_id track_id) (pos (+ (?? x.pos 0) 1))))))\u000a    (refuse \"playlist_id: no such playlist\")))\u000a\u000a(mutator demo.create_playlist\u000a  ((name Name))\u000a  (if (== (len (filter playlist (fn (p) (and (== p.user_id ctx.user) (== p.name name))))) 0)\u000a    (insert playlist (record (id (new-id playlist)) (name name) (user_id ctx.user)))))\u000a\u000a(mutator demo.remove_from_playlist\u000a  ((playlist_id (id playlist)) (text Text))\u000a  (delete item playlist_id text))\u000a\u000a(mutator demo.rename_playlist\u000a  ((playlist_id (id playlist)) (name Name))\u000a  (if (some? (get playlist playlist_id))\u000a    (update playlist playlist_id (fn (p) (record (id p.id) (name name) (user_id p.user_id))))\u000a    (refuse \"no such playlist\")))\u000a",
