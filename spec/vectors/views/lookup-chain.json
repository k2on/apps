  "ark": "(schema\u000a  (table playlist (id (id playlist) key) (name Text) (user_id Text) (index unique user_id name))\u000a  (table item\u000a    (playlist_id (id playlist) key (refs playlist))\u000a    (track_id Text key)\u000a    (pos Int)\u000a    (index unique playlist_id pos))\u000a  (table person (name Text key) (born Int))\u000a  (table work (id Text key) (composer Text (refs person)) (title Text) (index composer))\u000a  (table movement (id Text key) (work_id Text (refs work)) (no Int) (part Text) (index work_id))\u000a  (table song\u000a    (id Text key)\u000a    (title Text)\u000a    (creator Text)\u000a    (movement_id (option Text) (refs movement))\u000a    (pos Int)\u000a    (index creator)\u000a    (index movement_id)))\u000a\u000a(query lookup-chain\u000a  ()\u000a  (list (row work))\u000a  (map (sort song (fn (s) (tuple s.pos s.id)))\u000a    (fn (s)\u000a      (match s.movement_id\u000a        (none () (record (id \"\") (composer s.title) (title \"\")))\u000a        (some (text)\u000a          (match (get movement text)\u000a            (none () (record (id \"\") (composer s.title) (title \"\")))\u000a            (some (m)\u000a              (record (id m.part)\u000a                (composer s.title)\u000a                (title (?? (. (get work m.work_id) title) \"\"))))))))))\u000a",
