  "ark": "(schema\u000a  (table playlist (id (id playlist) key) (name Text) (user_id Text) (index unique user_id name))\u000a  (table item\u000a    (playlist_id (id playlist) key (refs playlist))\u000a    (track_id Text key)\u000a    (pos Int)\u000a    (index unique playlist_id pos))\u000a  (table person (name Text key) (born Int))\u000a  (table work (id Text key) (composer Text (refs person)) (title Text) (index composer))\u000a  (table movement (id Text key) (work_id Text (refs work)) (no Int) (part Text) (index work_id))\u000a  (table song\u000a    (id Text key)\u000a    (title Text)\u000a    (creator Text)\u000a    (movement_id (option Text) (refs movement))\u000a    (pos Int)\u000a    (index creator)\u000a    (index movement_id)))\u000a\u000a(query related-three-deep\u000a  ()\u000a  (list\u000a    (tuple Text\u000a      Int\u000a      (list (tuple Text Text Text (list (tuple Text Text Int Text (list (row song))))))))\u000a  (map person\u000a    (fn (p)\u000a      (tuple p.name\u000a        p.born\u000a        (map (filter work (fn (w) (== w.composer p.name)))\u000a          (fn (w)\u000a            (tuple w.id\u000a              w.composer\u000a              w.title\u000a              (map (filter movement (fn (m) (== m.work_id w.id)))\u000a                (fn (m)\u000a                  (tuple m.id\u000a                    m.work_id\u000a                    m.no\u000a                    m.part\u000a                    (filter song (fn (s) (== s.movement_id (some m.id))))))))))))))\u000a",
